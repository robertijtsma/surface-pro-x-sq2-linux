#!/usr/bin/env python3
"""
Surface Pro X - Ambient Light Sensor & Adaptive Auto-Brightness Daemon
Hardware: ams OSRAM TCS3430 on /dev/i2c-0 (address 0x39)
Features:
1. Windows 11 Adaptive Brightness matching Surface hardware (no excessive darkening).
2. Ultra-Smooth Cinematic Fading: 33 FPS cubic smoothstep transitions (e.g. 6 -> 5 -> 4 -> 3 -> 2).
3. Full User Control: dragging the slider immediately locks your chosen preference.
4. Relative Scaling: scales smoothly with major room lighting changes while preserving your offset.
5. Respects GNOME 'ambient-enabled' setting (Settings -> Power -> Automatic Screen Brightness).
"""

import sys
import os
import time
import fcntl
import ctypes
import struct
import math
import signal

try:
    import gi
    from gi.repository import Gio, GLib
except ImportError:
    print("[Error] PyGObject is required.", file=sys.stderr)
    sys.exit(1)

# I2C constants
I2C_RDWR = 0x0707
I2C_M_RD = 0x0001

class I2CMsg(ctypes.Structure):
    _fields_ = [
        ('addr', ctypes.c_uint16),
        ('flags', ctypes.c_uint16),
        ('len', ctypes.c_uint16),
        ('buf', ctypes.POINTER(ctypes.c_uint8)),
    ]

class I2CRdwrData(ctypes.Structure):
    _fields_ = [
        ('msgs', ctypes.POINTER(I2CMsg)),
        ('nmsgs', ctypes.c_uint32),
    ]

# TCS3430 Registers
TCS3430_ADDR = 0x39
REG_ENABLE = 0x80
REG_ATIME  = 0x81
REG_CFG1   = 0x90
REG_ID     = 0x92
REG_CH0DATAL = 0x94

GAIN_MAP = {
    0: 1,    # 1X
    1: 4,    # 4X
    2: 16,   # 16X
    3: 64,   # 64X
}

class TCS3430:
    def __init__(self, dev_path="/dev/i2c-0"):
        self.dev_path = dev_path
        self.fd = None
        self.gain_code = 3  # Start at 64x
        self.iio_lux_path = self._find_iio_lux()
        if not self.iio_lux_path:
            self.open_sensor()

    @staticmethod
    def _find_iio_lux():
        base = "/sys/bus/iio/devices"
        if not os.path.isdir(base):
            return None
        for d in sorted(os.listdir(base)):
            np = os.path.join(base, d, "name")
            lp = os.path.join(base, d, "in_illuminance_input")
            try:
                if os.path.exists(np) and os.path.exists(lp):
                    with open(np, "r") as f:
                        if f.read().strip() == "spx-tcs3430":
                            print(f"[TCS3430] Using kernel IIO driver at {lp}")
                            return lp
            except Exception:
                pass
        return None

    def open_sensor(self):
        try:
            self.fd = os.open(self.dev_path, os.O_RDWR)
            chip_id = self.read_reg(REG_ID)
            if chip_id == 0xDC:
                print(f"[TCS3430] Connected to sensor at 0x39 (ID 0xDC)")
            else:
                print(f"[TCS3430] Warning: ID 0x{chip_id:02x} (expected 0xDC)", file=sys.stderr)

            # ATIME: 71 (72 integration cycles = ~200ms)
            self.write_reg(REG_ATIME, 71)
            # CFG1: ALS gain
            self.write_reg(REG_CFG1, self.gain_code)
            # ENABLE: PON (1) | AEN (2) = 0x03
            self.write_reg(REG_ENABLE, 0x03)
            time.sleep(0.25)
        except Exception as e:
            print(f"[TCS3430] Error opening {self.dev_path}: {e}", file=sys.stderr)
            self.fd = None

    def write_reg(self, reg, val):
        if self.fd is None:
            return
        buf = (ctypes.c_uint8 * 2)(reg, val)
        msg = I2CMsg(addr=TCS3430_ADDR, flags=0, len=2, buf=buf)
        data = I2CRdwrData(msgs=ctypes.pointer(msg), nmsgs=1)
        fcntl.ioctl(self.fd, I2C_RDWR, data)

    def read_regs(self, reg, length):
        if self.fd is None:
            return None
        wbuf = (ctypes.c_uint8 * 1)(reg)
        rbuf = (ctypes.c_uint8 * length)()
        msgs = (I2CMsg * 2)(
            I2CMsg(addr=TCS3430_ADDR, flags=0, len=1, buf=wbuf),
            I2CMsg(addr=TCS3430_ADDR, flags=I2C_M_RD, len=length, buf=rbuf),
        )
        data = I2CRdwrData(msgs=msgs, nmsgs=2)
        fcntl.ioctl(self.fd, I2C_RDWR, data)
        return bytes(rbuf)

    def read_reg(self, reg):
        res = self.read_regs(reg, 1)
        return res[0] if res else 0

    def read_lux(self):
        if not getattr(self, "iio_lux_path", None):
            self.iio_lux_path = self._find_iio_lux()
        if self.iio_lux_path:
            try:
                with open(self.iio_lux_path, "r") as f:
                    return float(f.read().strip())
            except Exception:
                self.iio_lux_path = None
        if self.fd is None:
            self.open_sensor()
            if self.fd is None:
                return None

        try:
            raw_bytes = self.read_regs(REG_CH0DATAL, 8)
            if not raw_bytes:
                return None
            z, y, ir1, x = struct.unpack('<HHHH', raw_bytes)

            gain = GAIN_MAP.get(self.gain_code, 64)

            # Dynamic auto-ranging
            if y > 52000 and self.gain_code > 0:
                self.gain_code -= 1
                self.write_reg(REG_CFG1, self.gain_code)
            elif y < 200 and self.gain_code < 3:
                self.gain_code += 1
                self.write_reg(REG_CFG1, self.gain_code)

            lux = (y * 64.0) / float(gain)
            return lux
        except Exception as e:
            print(f"[TCS3430] Read error: {e}", file=sys.stderr)
            try:
                if self.fd is not None:
                    os.close(self.fd)
            except Exception:
                pass
            self.fd = None
            return None

    def close(self):
        if self.fd is not None:
            try:
                self.write_reg(REG_ENABLE, 0x00)
                os.close(self.fd)
            except Exception:
                pass
            self.fd = None


class MutterBacklight:
    """Controls display backlight via GNOME Mutter DisplayConfig D-Bus."""
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.proxy = Gio.DBusProxy.new_sync(
            self.bus,
            Gio.DBusProxyFlags.NONE,
            None,
            'org.gnome.Mutter.DisplayConfig',
            '/org/gnome/Mutter/DisplayConfig',
            'org.gnome.Mutter.DisplayConfig',
            None
        )
        self.connector = 'eDP-1'
        self.min_val = 40
        self.max_val = 4095
        self.serial = 0
        self.refresh()

    def refresh(self):
        try:
            prop = self.proxy.call_sync(
                'org.freedesktop.DBus.Properties.Get',
                GLib.Variant('(ss)', ('org.gnome.Mutter.DisplayConfig', 'Backlight')),
                Gio.DBusCallFlags.NONE, 500, None
            )
            val = prop.unpack()[0]
            if not val or len(val) < 2 or not val[1]:
                return None
            self.serial = val[0]
            bl = val[1][0]
            self.connector = bl.get('connector', 'eDP-1')
            self.min_val = bl.get('min', 40)
            self.max_val = bl.get('max', 4095)
            return bl.get('value', 2300)
        except Exception as e:
            print(f"[MutterBacklight] Error: {e}", file=sys.stderr)
            return None

    def set_backlight(self, value):
        try:
            clamped = max(self.min_val, min(self.max_val, int(value)))
            if getattr(self, '_in_flight', False):
                return clamped
            self._in_flight = True

            def _on_done(source, res):
                try:
                    source.call_finish(res)
                except Exception:
                    pass
                finally:
                    self._in_flight = False

            self.proxy.call(
                'SetBacklight',
                GLib.Variant('(usi)', (self.serial, self.connector, clamped)),
                Gio.DBusCallFlags.NONE, 600, None, _on_done
            )
            return clamped
        except Exception:
            self._in_flight = False
            return None


class SmoothFadeAnimator:
    """
    33 FPS Cubic Smoothstep Easing engine (Hermite interpolation).
    Smoothly transitions brightness through every intermediate step without sudden jumps.
    """
    def __init__(self, backlight):
        self.backlight = backlight
        self.anim_timer_id = None
        self.start_val = 0
        self.target_val = 0
        self.current_val = 0
        self.start_time = 0.0
        self.duration = 1.5

    @property
    def is_animating(self):
        return self.anim_timer_id is not None

    def start_transition(self, current_val, target_val, on_progress_callback=None):
        if self.is_animating:
            try:
                GLib.source_remove(self.anim_timer_id)
            except Exception:
                pass
            self.anim_timer_id = None

        if abs(current_val - target_val) < 10:
            self.backlight.set_backlight(target_val)
            self.current_val = target_val
            return

        self.start_val = current_val
        self.target_val = target_val
        self.current_val = current_val
        self.on_progress_callback = on_progress_callback
        self.start_time = time.time()

        # Duration scales smoothly with difference: 1.0s to 2.2s
        delta = abs(target_val - current_val)
        self.duration = max(1.0, min(2.2, 0.6 + 1.6 * (delta / 2000.0)))

        # Run at 30ms (~33 FPS) for buttery smooth analog dimming
        self.anim_timer_id = GLib.timeout_add(80, self._on_step)

    def _on_step(self):
        now = time.time()
        elapsed = now - self.start_time
        t = min(1.0, elapsed / self.duration)

        # Smoothstep curve: 3t^2 - 2t^3 (zero acceleration at ends, silky glide in middle)
        smooth_progress = t * t * (3.0 - 2.0 * t)
        val = int(self.start_val + (self.target_val - self.start_val) * smooth_progress)

        self.backlight.set_backlight(val)
        self.current_val = val

        if self.on_progress_callback:
            self.on_progress_callback(val)

        if t >= 1.0:
            self.anim_timer_id = None
            return False
        return True

    def stop(self):
        if self.anim_timer_id is not None:
            try:
                GLib.source_remove(self.anim_timer_id)
            except Exception:
                pass
            self.anim_timer_id = None


class WindowsStyleAdaptiveBrightness:
    def __init__(self):
        self.sensor = TCS3430()
        self.backlight = MutterBacklight()
        self.animator = SmoothFadeAnimator(self.backlight)

        # Connect GNOME settings for ambient-enabled
        self.settings = None
        try:
            self.settings = Gio.Settings.new('org.gnome.settings-daemon.plugins.power')
            self.settings.connect('changed::ambient-enabled', self.on_setting_changed)
            print("[AutoBrightness] Connected to org.gnome.settings-daemon.plugins.power (ambient-enabled)")
        except Exception as e:
            print(f"[AutoBrightness] Notice: Gio.Settings: {e}")

        # Current state
        current_hw = self.backlight.refresh() or 2300
        self.current_brightness = current_hw
        self.last_daemon_applied = current_hw
        self.target_brightness = current_hw

        # Smooth filter
        self.smoothed_lux = None

        # User Preference Model
        self.user_ratio = 1.0
        self.user_reference_lux = None
        self.last_user_touch_time = 0.0

    def is_enabled(self):
        if self.settings:
            return self.settings.get_boolean('ambient-enabled')
        return True

    def on_setting_changed(self, settings, key):
        enabled = self.settings.get_boolean('ambient-enabled')
        print(f"[AutoBrightness] GNOME ambient-enabled toggled: {enabled}")
        if enabled:
            self.user_ratio = 1.0
            self.user_reference_lux = None

    @staticmethod
    def base_curve_pct(lux):
        """
        Factory Surface Windows curve:
        - 0 lux: 32% (comfortable low light, not dark)
        - 18 lux: 47% (typical evening room)
        - 100 lux: 58% (well lit indoor room)
        - 500 lux: 76% (near daylight window)
        - 2000+ lux: 100% (bright sunlight)
        """
        if lux <= 0.1:
            return 32.0
        clamped = min(2000.0, max(0.1, lux))
        pct = 32.0 + 68.0 * ((clamped / 2000.0) ** 0.32)
        return max(25.0, min(100.0, pct))

    def check_user_override(self):
        """Check if user manually dragged the GNOME brightness slider."""
        current_hw = self.backlight.refresh()
        if current_hw is None:
            return

        # If user moved slider (diff > 50 units and animator isn't actively setting it)
        diff = abs(current_hw - self.last_daemon_applied)
        if diff > 50 and not self.animator.is_animating:
            # User moved the slider! Cancel any pending animation
            self.animator.stop()

            current_lux = self.smoothed_lux or 18.0
            base_pct = self.base_curve_pct(current_lux)
            base_val = (base_pct / 100.0) * self.backlight.max_val

            self.user_ratio = max(0.3, min(2.5, current_hw / max(100.0, base_val)))
            self.user_reference_lux = current_lux
            self.last_user_touch_time = time.time()
            self.current_brightness = current_hw
            self.last_daemon_applied = current_hw
            self.target_brightness = current_hw

            pct = (current_hw / float(self.backlight.max_val)) * 100.0
            print(f"[AutoBrightness] User adjusted slider to {pct:.0f}% ({current_hw}/{self.backlight.max_val}). Preference locked! (Ratio: {self.user_ratio:.2f})")

    def on_anim_step(self, val):
        self.last_daemon_applied = val
        self.current_brightness = val

    def tick_sensor(self):
        """Periodic loop (runs every 600ms)."""
        if not self.is_enabled():
            return True

        # 1. Check for manual slider changes first
        self.check_user_override()

        # 2. Read ambient light sensor
        lux = self.sensor.read_lux()
        if lux is None:
            return True

        # Exponential moving average filter
        if self.smoothed_lux is None:
            self.smoothed_lux = lux
            self.user_reference_lux = lux
        else:
            alpha = 0.20
            self.smoothed_lux = alpha * lux + (1.0 - alpha) * self.smoothed_lux

        now = time.time()
        time_since_user_touch = now - self.last_user_touch_time

        # 3. Windows Adaptive Lock Policy:
        # If user touched slider less than 45 seconds ago, stay locked at user brightness
        if time_since_user_touch < 45.0:
            if self.user_reference_lux:
                ratio = self.smoothed_lux / max(1.0, self.user_reference_lux)
                if 0.5 <= ratio <= 2.0:
                    return True  # Stay locked!

        # If ambient light has not changed by more than 28% from reference, keep current brightness
        if self.user_reference_lux:
            relative_change = abs(self.smoothed_lux - self.user_reference_lux) / max(1.0, self.user_reference_lux)
            if relative_change < 0.28:
                return True  # Stable environment, do not adjust

        # 4. Significant light change detected: calculate new target with user preference
        base_pct = self.base_curve_pct(self.smoothed_lux)
        target_pct = max(15.0, min(100.0, base_pct * self.user_ratio))
        new_target = int((target_pct / 100.0) * self.backlight.max_val)

        # Hysteresis deadband: minimum 100 counts (~2.5%) before triggering transition
        if abs(new_target - self.current_brightness) > 100:
            self.target_brightness = new_target
            self.user_reference_lux = self.smoothed_lux
            # Start ultra-smooth cubic transition through all intermediate levels
            self.animator.start_transition(self.current_brightness, new_target, self.on_anim_step)

        return True

    def run(self):
        print(f"[AutoBrightness] Windows-Style Adaptive Brightness with Smooth Fading active. Level: {self.current_brightness} / {self.backlight.max_val}")
        loop = GLib.MainLoop()
        GLib.timeout_add(600, self.tick_sensor)

        def sig_handler(sig, frame):
            print("\n[AutoBrightness] Exiting cleanly...")
            self.animator.stop()
            self.sensor.close()
            loop.quit()

        signal.signal(signal.SIGINT, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)

        loop.run()


if __name__ == '__main__':
    daemon = WindowsStyleAdaptiveBrightness()
    daemon.run()
