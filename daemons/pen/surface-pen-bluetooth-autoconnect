#!/usr/bin/env python3
"""
Surface Slim Pen Screen-Contact Bluetooth Auto-Connect Daemon.

Passively observes IPTSD stylus screen-contact events via evdev (zero uinput
devices created) and triggers BlueZ Device1.Connect() over D-Bus if the paired
Surface Pen is not already connected via kernel LE Accept-List auto-connect.

Configuration:
  - Set SURFACE_PEN_MAC="AA:BB:CC:DD:EE:FF" in the environment, OR
  - Leave unset to auto-discover any paired BlueZ device matching "Surface*Pen".
"""

import os
import select
import signal
import threading
import time
import dbus
import evdev
from evdev import ecodes as e

running = True
ADAPTER_PATH = "/org/bluez/hci0"

bus = None
target_path = None
pen_device = None
props_iface = None
connect_lock = threading.Lock()
is_connecting = False
last_connect_time = 0.0


def handle_sig(sig, frame):
    global running
    running = False


signal.signal(signal.SIGTERM, handle_sig)
signal.signal(signal.SIGINT, handle_sig)


def reset_dbus():
    global target_path, pen_device, props_iface
    target_path = None
    pen_device = None
    props_iface = None


def discover_target_path(sys_bus):
    mac = os.environ.get("SURFACE_PEN_MAC", "").strip().upper()
    if mac:
        return f"{ADAPTER_PATH}/dev_{mac.replace(':', '_')}"

    om = dbus.Interface(
        sys_bus.get_object("org.bluez", "/"),
        "org.freedesktop.DBus.ObjectManager",
    )
    for path, ifaces in om.GetManagedObjects().items():
        dev = ifaces.get("org.bluez.Device1")
        if not dev or not dev.get("Paired"):
            continue
        name = str(dev.get("Name", "") or dev.get("Alias", ""))
        if "surface" in name.lower() and "pen" in name.lower():
            return str(path)
    return None


def ensure_dbus():
    global bus, target_path, pen_device, props_iface
    if pen_device is not None and props_iface is not None:
        return True
    try:
        if bus is None:
            bus = dbus.SystemBus()
        path = discover_target_path(bus)
        if not path:
            return False
        pen_obj = bus.get_object("org.bluez", path)
        pen_device = dbus.Interface(pen_obj, "org.bluez.Device1")
        props_iface = dbus.Interface(pen_obj, "org.freedesktop.DBus.Properties")
        target_path = path
        print(f"Bound to paired Surface Pen at {target_path}", flush=True)
        return True
    except Exception as exc:
        reset_dbus()
        print(f"D-Bus init deferred: {exc}", flush=True)
        return False


def auto_connect():
    global last_connect_time, is_connecting

    now = time.monotonic()
    with connect_lock:
        if is_connecting or (now - last_connect_time) < 15.0:
            return

    if not ensure_dbus():
        return

    try:
        connected = bool(props_iface.Get("org.bluez.Device1", "Connected"))
    except dbus.DBusException as exc:
        print(f"BlueZ proxy invalidated ({exc}); rebinding...", flush=True)
        reset_dbus()
        if not ensure_dbus():
            return
        try:
            connected = bool(props_iface.Get("org.bluez.Device1", "Connected"))
        except Exception as retry_exc:
            print(f"Error checking Bluetooth state: {retry_exc}", flush=True)
            reset_dbus()
            return
    except Exception as exc:
        print(f"Error checking Bluetooth state: {exc}", flush=True)
        return

    if connected:
        return

    with connect_lock:
        if is_connecting:
            return
        is_connecting = True
        last_connect_time = now

    dev = pen_device
    print("Pen contact detected; requesting Bluetooth connection...", flush=True)

    def worker():
        global is_connecting
        try:
            dev.Connect(timeout=10)
            print("Surface Pen connected via Bluetooth.", flush=True)
        except dbus.DBusException as err:
            err_name = err.get_dbus_name() or ""
            if "ServiceUnknown" in err_name or "UnknownObject" in err_name:
                reset_dbus()
            print(f"Bluetooth connect result: {err}", flush=True)
        except Exception as err:
            print(f"Bluetooth connect result: {err}", flush=True)
        finally:
            with connect_lock:
                is_connecting = False

    threading.Thread(target=worker, daemon=True).start()


def find_stylus():
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
            if "IPTSD" in dev.name and "Stylus" in dev.name:
                return dev
            dev.close()
        except OSError:
            pass
    return None


def main():
    ensure_dbus()
    print("Surface Pen Screen-Contact Auto-Connector initialized (Pure D-Bus, zero uinput).", flush=True)

    while running:
        stylus = find_stylus()
        if not stylus:
            time.sleep(2)
            continue

        print(f"Listening for screen contact on: {stylus.name} ({stylus.path})", flush=True)

        try:
            while running:
                r, _, _ = select.select([stylus.fd], [], [], 1.0)
                if not running:
                    break
                if r:
                    for event in stylus.read():
                        if event.type == e.EV_KEY and event.code in (e.BTN_TOOL_PEN, e.BTN_TOUCH) and event.value == 1:
                            auto_connect()
        except OSError:
            time.sleep(1)
        finally:
            try:
                stylus.close()
            except OSError:
                pass

    print("Shutting down cleanly.", flush=True)


if __name__ == "__main__":
    main()
