# Surface Pro X SLPI sensor hub (LSM6DSO accelerometer / AK0991x compass via libssc)
ACTION=="remove", GOTO="spx_sensors_end"
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hexagonrpcd-sdsp.service"
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel ssc-compass", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1"
LABEL="spx_sensors_end"
