#!/usr/bin/env bash
set -euo pipefail

echo "=== Loading Surface Pro X SQ2 Camera & IR Face ID Subsystem ==="

# Skip gracefully if booted with a non-camera fallback DTB
if [ ! -d /sys/firmware/devicetree/base/soc@0/isp@acaf000 ]; then
    echo "[i] Active DTB has no isp@acaf000 node; skipping camera bring-up."
    exit 0
fi

echo "[1/4] Enabling PMC8180-A camera SPMI LDO rails and CAMCC clocks..."
modprobe surface_cam_spmi
modprobe camcc_sc8180x

echo "[2/4] Loading MIPI CSI-2 PHY and CCI I2C controllers..."
modprobe phy_qcom_mipi_csi2
modprobe i2c_qcom_cci

echo "[3/4] Loading camera sensors (OV13858 13MP, OV5693 5MP, OV7251 IR)..."
modprobe ov13858
modprobe ov5693
modprobe ov7251

echo "[4/4] Loading Qualcomm Spectra 380 CAMSS driver..."
modprobe qcom_camss
modprobe surface_ir_sfmt 2>/dev/null || true

for _ in 1 2 3 4 5 6; do
    [ -e /dev/media0 ] && break
    sleep 0.5
done

/usr/local/bin/surface-camera-check

echo "=== Camera & Face ID Subsystem Ready ==="
