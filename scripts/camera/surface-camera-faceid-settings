        return page

    def refresh_howdy_models(self):
        for r in self.model_rows:
            self.grp_models.remove(r)
        self.model_rows.clear()

        user = os.environ.get("SUDO_USER") or os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
        try:
            res = subprocess.run(
                ["sudo", "howdy", "list", "-U", user],
                capture_output=True, text=True, timeout=5
            )
            out = res.stdout.strip()
        except Exception as e:
            out = f"Fout bij uitlezen Howdy: {e}"

        models = []
        for line in out.splitlines():
            line = line.strip()
            if line and not line.startswith("ID") and not line.startswith("No face") and not line.startswith("="):
                parts = line.split()
                if len(parts) >= 2 and parts[0].isdigit():
                    models.append((parts[0], " ".join(parts[1:])))

        if not models:
            row_empty = Adw.ActionRow(
                title="Geen modellen geregistreerd",
                subtitle="Druk op 'Gezicht Scannen' hierboven om uw gezicht toe te voegen."
            )
            self.grp_models.add(row_empty)
            self.model_rows.append(row_empty)
        else:
            for m_id, m_desc in models:
                row = Adw.ActionRow(title=f"Profiel #{m_id}: {m_desc}")
                btn_del = Gtk.Button(label="Verwijderen")
                btn_del.set_valign(Gtk.Align.CENTER)
                btn_del.add_css_class("destructive-action")
                btn_del.connect("clicked", self.on_delete_model, m_id)
                row.add_suffix(btn_del)
                self.grp_models.add(row)
                self.model_rows.append(row)

    def on_add_face(self, btn):
        if self.is_streaming:
            self.stop_stream()
        user = os.environ.get("SUDO_USER") or os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
        self.show_toast("IR-camera scant nu uw gezicht... Kijk recht naar het rode IR-lampje!")

        def _worker():
            try:
                label = f"Surface-IR-{time.strftime('%H:%M')}"
                res = subprocess.run(
                    ["sudo", "howdy", "add", "-U", user, "-y", "--plain", label],
                    capture_output=True, text=True, timeout=10
                )
                if res.returncode == 0:
                    GLib.idle_add(self.show_toast, f"Gezichtsprofiel '{label}' succesvol opgeslagen!")
                    GLib.idle_add(self.refresh_howdy_models)
                else:
                    GLib.idle_add(self.show_toast, "Geen gezicht gedetecteerd. Kijk recht in de camera en probeer opnieuw.")
            except Exception as e:
                GLib.idle_add(self.show_toast, f"Fout bij scannen: {e}")

        threading.Thread(target=_worker, daemon=True).start()

    def on_test_face(self, btn):
        if self.is_streaming:
            self.stop_stream()
        user = os.environ.get("SUDO_USER") or os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
        self.show_toast("IR Face ID verificatie gestart...")

        def _worker():
            t0 = time.time()
            try:
                res = subprocess.run(
                    ["sudo", "/usr/lib/howdy/howdy-compare", user],
                    capture_output=True, text=True, timeout=8
                )
                dt_ms = int((time.time() - t0) * 1000)
                if res.returncode == 0:
                    GLib.idle_add(
                        self.show_toast,
                        f"Face ID Geslaagd! Gezicht herkend als '{user}' in {dt_ms} ms."
                    )
                else:
                    GLib.idle_add(
                        self.show_toast,
                        f"Gezicht niet herkend (code {res.returncode}). Kijk recht in de IR-camera."
                    )
            except Exception as e:
                GLib.idle_add(self.show_toast, f"Fout bij Face ID test: {e}")

        threading.Thread(target=_worker, daemon=True).start()

