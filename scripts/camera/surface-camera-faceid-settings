APP_ID = "com.microsoft.surface.camera.settings"

LIBCAM_FRONT_ID = "/base/soc@0/cci@ac4a000/i2c-bus@1/camera@36"
LIBCAM_REAR_ID = "/base/soc@0/cci@ac4a000/i2c-bus@0/camera@10"
IR_DEV_PATH = "/dev/video-ir"


def _spawn_detached(cmd):
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    threading.Thread(target=proc.wait, daemon=True).start()
    return proc


class SurfaceCameraApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.window = None

    def do_activate(self):
        if not self.window:
            self.window = CameraSettingsWindow(self)
        self.window.present()


class CameraSettingsWindow(Adw.ApplicationWindow):
