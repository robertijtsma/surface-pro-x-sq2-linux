    def check_sudo_nopasswd(self):
        try:
            res = subprocess.run(["sudo", "-n", "cat", "/etc/sudoers.d/wheel"], capture_output=True, text=True)
            if res.returncode == 0:
                return "NOPASSWD:" in res.stdout
        except Exception:
            pass
        return False

    def on_toggle_nopasswd(self, switch_row, param):
        active = switch_row.get_active()
        try:
            if active:
                _run_privileged("echo '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel && chmod 0440 /etc/sudoers.d/wheel")
                self.show_toast("Wachtwoordloos 'sudo' (NOPASSWD) ingeschakeld.")
            else:
                _run_privileged("echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel && chmod 0440 /etc/sudoers.d/wheel")
                self.show_toast("IR Face ID voor 'sudo' in de terminal geactiveerd!")
        except Exception as e:
            self.show_toast(f"Fout bij instellen sudoers: {e}")

    def check_pam_howdy(self, path):
        if not os.path.exists(path):
            return False
        try:
            with open(path, 'r') as f:
                content = f.read()
            return "pam_howdy.so" in content and not content.strip().startswith("#auth sufficient pam_howdy")
        except Exception:
            return False

    def on_toggle_pam(self, switch_row, param, pam_file):
        active = switch_row.get_active()
        try:
            if active:
                _run_privileged(f"""
                if ! grep -q "pam_howdy.so" {pam_file}; then
                    if grep -q "#%PAM-1.0" {pam_file}; then
                        sed -i '/#%PAM-1.0/a auth       sufficient                  pam_howdy.so' {pam_file}
                    else
                        sed -i '1s/^/auth       sufficient                  pam_howdy.so\\n/' {pam_file}
                    fi
                fi
                """)
                self.show_toast(f"Face ID ingeschakeld voor {os.path.basename(pam_file)}")
            else:
                _run_privileged(f"sed -i '/pam_howdy.so/d' {pam_file}")
                self.show_toast(f"Face ID uitgeschakeld voor {os.path.basename(pam_file)}")
        except Exception as e:
            self.show_toast(f"Fout bij instellen PAM: {e}")

