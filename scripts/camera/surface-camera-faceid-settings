        super().__init__(application=app, title="Camera en Gezichtsherkenning")
        self.set_default_size(880, 700)

        # Stream state
        self.cap = None
        self.gst_proc = None
        self.is_streaming = False
        self.last_rgb_frame = None
        self.stream_thread = None
        self.model_rows = []

        self.setup_ui()
        self.refresh_howdy_models()

