    def on_camera_selected(self, dropdown, param):
        self.extra_rot = 0
        if self.is_streaming:
            self.stop_stream()
            self.start_stream()

    def on_rotate_clicked(self, btn):
        self.extra_rot = (self.extra_rot + 1) % 4
        self.show_toast(f"Rotatie: {self.extra_rot * 90}°")

    def _apply_extra_rotation(self, img):
        if self.extra_rot == 1:
            return cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
        elif self.extra_rot == 2:
            return cv2.rotate(img, cv2.ROTATE_180)
        elif self.extra_rot == 3:
            return cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)
        return img

    def on_toggle_stream(self, btn):
        if self.is_streaming:
            self.stop_stream()
        else:
            self.start_stream()

    def _apply_sensor_tuning(self):
        """Stel optimale lage-ruis sensor-controls in voor maximale scherpte zonder highlight-clipping."""
        try:
            for d in os.listdir("/sys/class/video4linux"):
                if not d.startswith("v4l-subdev"):
                    continue
                name_path = f"/sys/class/video4linux/{d}/name"
                if not os.path.exists(name_path):
                    continue
                with open(name_path, "r") as f:
                    name = f.read().strip()
                dev = f"/dev/{d}"
                if name == "ov5693 4-0036":
                    subprocess.run(["v4l2-ctl", "-d", dev, "--set-ctrl=vertical_blanking=1200"], capture_output=True)
                    subprocess.run(["v4l2-ctl", "-d", dev, "--set-ctrl=digital_gain=1350,analogue_gain=32,exposure=2400"], capture_output=True)
                elif name == "ov13858 3-0010":
                    subprocess.run(["v4l2-ctl", "-d", dev, "--set-ctrl=vertical_blanking=1600"], capture_output=True)
                    subprocess.run(["v4l2-ctl", "-d", dev, "--set-ctrl=digital_gain=2048,analogue_gain=768,exposure=3200"], capture_output=True)
                elif name == "ov7251 3-0060":
                    subprocess.run(["v4l2-ctl", "-d", dev, "--set-ctrl=gain=32,exposure=550,horizontal_flip=0,vertical_flip=0"], capture_output=True)
        except Exception:
            pass

    def start_stream(self):
        self._apply_sensor_tuning()
        idx = self.cam_dropdown.get_selected()
        self.is_streaming = True
        self.last_rgb_frame = None
        self.toggle_stream_btn.set_label("Stop Preview")
        self.toggle_stream_btn.remove_css_class("suggested-action")
        self.toggle_stream_btn.add_css_class("destructive-action")
        self.snapshot_btn.set_sensitive(True)

        if idx == 0:
            self.info_label.set_text("Actieve stream: Voorcamera 5 MP • Adreno 685 GPU DebayerEGL + Pro ISP (Witte LED voorop brandt)")
            self.stream_thread = threading.Thread(
                target=self._libcamera_stream_worker, args=(LIBCAM_FRONT_ID, 2048, 1536, 1024, 768), daemon=True
            )
        elif idx == 1:
            self.info_label.set_text("Actieve stream: Achtercamera 13 MP • Adreno 685 GPU DebayerEGL + Pro ISP (Witte LED achterop brandt)")
            self.stream_thread = threading.Thread(
                target=self._libcamera_stream_worker, args=(LIBCAM_REAR_ID, 2048, 1536, 1024, 768), daemon=True
            )
        else:
            self.info_label.set_text("Actieve stream: Infraroodcamera OV7251 • Hardware Y10 + Pro ISP (Rode IR-illuminator brandt)")
            self.stream_thread = threading.Thread(
                target=self._ir_stream_worker, args=(IR_DEV_PATH,), daemon=True
            )
        self.stream_thread.start()

    def stop_stream(self):
        self.is_streaming = False
        if self.gst_proc:
            try:
                self.gst_proc.terminate()
                self.gst_proc.wait(timeout=2)
            except Exception:
                try:
                    self.gst_proc.kill()
                except Exception:
                    pass
            self.gst_proc = None

        if self.cap:
            try:
                self.cap.release()
            except Exception:
                pass
            self.cap = None

        self.toggle_stream_btn.set_label("Start Preview")
        self.toggle_stream_btn.remove_css_class("destructive-action")
        self.toggle_stream_btn.add_css_class("suggested-action")
        self.snapshot_btn.set_sensitive(False)
        self.info_label.set_text("Preview gestopt. Alle camera- en IR-lampjes zijn uit.")
        self.preview_picture.set_pixbuf(None)

    def _process_pro_isp_rgb(self, rgba_full, out_w, out_h, prev_f, clahe, tone_lut):
        """
        Real-time Ultra ISP pijplijn:
        1. 4x Area Supersampling (2048x1536 -> 1024x768) verlaagt shot-noise met 2x en behoudt volledige groothoek.
        2. Sterke Motion-adaptive temporele ruisonderdrukking (EMA alpha 0.22..1.0).
        3. YCrCb piramidale chroma-denoising + Shadow Chroma Desaturation (diepzwarte schaduwen zonder groene/rode korrel).
        4. Edge-preserving Bilateral Luma Denoising + Soft-Knee S-curve LUT + CLAHE HDR + Edge-Coring Detail Sharpening.
        """
        small_rgba = cv2.resize(rgba_full, (out_w, out_h), interpolation=cv2.INTER_AREA)
        bgr = cv2.cvtColor(small_rgba, cv2.COLOR_RGBA2BGR)

        if self.mirror_btn.get_active():
            bgr = cv2.flip(bgr, 1)
        bgr = self._apply_extra_rotation(bgr)

        if not self.pro_isp_btn.get_active():
            return cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB), None

        # Motion-adaptive temporal blend (ca. 4.5-frame middeling in statische delen, 0 ghosting bij beweging)
        curr_f = bgr.astype(np.float32)
        if prev_f is not None and prev_f.shape == curr_f.shape:
            diff = np.abs(curr_f - prev_f).mean(axis=2, keepdims=True)
            alpha = np.clip((diff - 3.5) / 16.0, 0.22, 1.0)
            blended_f = curr_f * alpha + prev_f * (1.0 - alpha)
            bgr = blended_f.astype(np.uint8)
        else:
            blended_f = curr_f

        ycrcb = cv2.cvtColor(bgr, cv2.COLOR_BGR2YCrCb)
        y, cr, cb = cv2.split(ycrcb)
        cur_h, cur_w = y.shape

        # Piramidale chroma-ruisonderdrukking + Shadow Chroma Desaturation op 1/4 resolutie
        cw, ch = cur_w // 4, cur_h // 4
        y_s = cv2.resize(y, (cw, ch), interpolation=cv2.INTER_AREA).astype(np.float32)
        cr_s = cv2.GaussianBlur(cv2.resize(cr, (cw, ch), interpolation=cv2.INTER_AREA), (7, 7), 0).astype(np.float32)
        cb_s = cv2.GaussianBlur(cv2.resize(cb, (cw, ch), interpolation=cv2.INTER_AREA), (7, 7), 0).astype(np.float32)

        shadow_w = np.clip((y_s - 14.0) / 42.0, 0.0, 1.0) * 1.10
        cr_s = np.clip(128.0 + (cr_s - 128.0) * shadow_w, 0, 255).astype(np.uint8)
        cb_s = np.clip(128.0 + (cb_s - 128.0) * shadow_w, 0, 255).astype(np.uint8)

        cr_clean = cv2.resize(cr_s, (cur_w, cur_h), interpolation=cv2.INTER_LINEAR)
        cb_clean = cv2.resize(cb_s, (cur_w, cur_h), interpolation=cv2.INTER_LINEAR)

        # Edge-preserving Bilateral Luma Denoising + Soft-Knee Tone Curve + CLAHE HDR
        y_dn = cv2.bilateralFilter(y, 5, 24, 24)
        y_toned = cv2.LUT(y_dn, tone_lut)
        y_clahe = clahe.apply(y_toned)
        y_hdr = cv2.addWeighted(y_toned, 0.65, y_clahe, 0.35, 0)

        # Edge-Coring Detail Sharpening (verscherpt alleen echte randen > 5, nooit ruis op vlakke delen!)
        y_blur = cv2.GaussianBlur(y_hdr, (0, 0), 1.1)
        detail = y_hdr.astype(np.int16) - y_blur.astype(np.int16)
        cored = np.where(np.abs(detail) > 5, detail - np.sign(detail) * 5, 0)
        y_sharp = np.clip(y_hdr.astype(np.int16) + (cored * 3) // 5, 0, 255).astype(np.uint8)

        rgb = cv2.cvtColor(cv2.merge([y_sharp, cr_clean, cb_clean]), cv2.COLOR_YCrCb2RGB)
        return rgb, blended_f

    def _libcamera_stream_worker(self, cam_id, cap_w, cap_h, out_w, out_h):
        cmd = [
            "gst-launch-1.0", "-q",
            "libcamerasrc", f"camera-name={cam_id}",
            "!", f"video/x-raw,format=RGBA,width={cap_w},height={cap_h}",
            "!", "fdsink", "fd=1"
        ]
        env = os.environ.copy()
        ipa_dir = "/etc/libcamera/ipa"
        if os.path.isdir(ipa_dir):
            env["LIBCAMERA_IPA_CONFIG_PATH"] = f"{ipa_dir}:/usr/share/libcamera/ipa"

        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env
            )
            self.gst_proc = proc
        except Exception as e:
            GLib.idle_add(self.show_toast, f"Kon libcamera niet starten: {e}")
            GLib.idle_add(self.stop_stream)
            return

        clahe = cv2.createCLAHE(clipLimit=1.25, tileGridSize=(8, 8))
        tone_lut = np.zeros(256, dtype=np.uint8)
        for i in range(256):
            x = max(0.0, (i - 8.0) / 247.0)
            y_val = (x ** 0.94) / (1.0 + 0.14 * (x ** 3.5)) * 1.12
            tone_lut[i] = int(np.clip(y_val * 255.0, 0, 255))

        prev_f = None
        frame_bytes = cap_w * cap_h * 4
        while self.is_streaming and proc.poll() is None:
            buf = proc.stdout.read(frame_bytes)
            if not buf or len(buf) < frame_bytes:
                break
            rgba = np.frombuffer(buf, dtype=np.uint8).reshape((cap_h, cap_w, 4))
            rgb, prev_f = self._process_pro_isp_rgb(rgba, out_w, out_h, prev_f, clahe, tone_lut)
            self.last_rgb_frame = rgb
            rh, rw, rc = rgb.shape
            pixbuf = GdkPixbuf.Pixbuf.new_from_data(
                rgb.tobytes(), GdkPixbuf.Colorspace.RGB, False, 8, rw, rh, rw * rc
            )
            GLib.idle_add(self._update_preview, pixbuf)

        try:
            proc.terminate()
        except Exception:
            pass

    def _ir_stream_worker(self, dev_path):
        cap = cv2.VideoCapture(dev_path, cv2.CAP_V4L2)
        self.cap = cap
        if not cap.isOpened():
            GLib.idle_add(self.show_toast, f"Kon IR-camera {dev_path} niet openen.")
            GLib.idle_add(self.stop_stream)
            return

        clahe = cv2.createCLAHE(clipLimit=1.8, tileGridSize=(8, 8))
        prev_f = None
        while self.is_streaming:
            ret, frame = cap.read()
            if not ret or frame is None:
                time.sleep(0.03)
                continue

            # De OV7251 IR-sensor op de Surface Pro X bezel is fysiek 90° gedraaid (portret-oriëntatie voor groter verticaal Face ID bereik)
            frame = cv2.rotate(frame, cv2.ROTATE_90_COUNTERCLOCKWISE)
            if self.mirror_btn.get_active():
                frame = cv2.flip(frame, 1)
            frame = self._apply_extra_rotation(frame)

            if self.pro_isp_btn.get_active():
                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                curr_f = gray.astype(np.float32)
                if prev_f is not None and prev_f.shape == curr_f.shape:
                    diff = np.abs(curr_f - prev_f)
                    alpha = np.clip((diff - 3.0) / 14.0, 0.25, 1.0)
                    blended_f = curr_f * alpha + prev_f * (1.0 - alpha)
                    gray = blended_f.astype(np.uint8)
                else:
                    blended_f = curr_f
                prev_f = blended_f
                dn = cv2.bilateralFilter(gray, 5, 20, 20)
                cl = clahe.apply(dn)
                hdr = cv2.addWeighted(dn, 0.50, cl, 0.50, 0)
                blur = cv2.GaussianBlur(hdr, (0, 0), 1.0)
                detail = hdr.astype(np.int16) - blur.astype(np.int16)
                cored = np.where(np.abs(detail) > 4, detail - np.sign(detail) * 4, 0)
                sharp = np.clip(hdr.astype(np.int16) + (cored * 3) // 5, 0, 255).astype(np.uint8)
                rgb_frame = cv2.cvtColor(sharp, cv2.COLOR_GRAY2RGB)
            else:
                rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

            self.last_rgb_frame = rgb_frame
            h, w, c = rgb_frame.shape
            pixbuf = GdkPixbuf.Pixbuf.new_from_data(
                rgb_frame.tobytes(), GdkPixbuf.Colorspace.RGB, False, 8, w, h, w * c
            )
            GLib.idle_add(self._update_preview, pixbuf)
            time.sleep(0.025)

        cap.release()

    def _update_preview(self, pixbuf):
        if self.is_streaming:
            self.preview_picture.set_pixbuf(pixbuf)
        return False

    def on_take_snapshot(self, btn):
        if not self.is_streaming or self.last_rgb_frame is None:
            return
        user_pics = os.path.expanduser("~/Afbeeldingen")
        if not os.path.exists(user_pics):
            user_pics = os.path.expanduser("~/Pictures")
        if not os.path.exists(user_pics):
            user_pics = os.path.expanduser("~")

        filename = os.path.join(user_pics, f"surface_foto_{int(time.time())}.jpg")
        bgr = cv2.cvtColor(self.last_rgb_frame, cv2.COLOR_RGB2BGR)
        cv2.imwrite(filename, bgr)
        self.show_toast(f"Foto opgeslagen: {filename}")

