#!/usr/bin/env bash
set -euo pipefail

echo "=== Configuring Surface Pro X SQ2 Camera Media Graph (OV5693 / OV13858 / OV7251) ==="

if [ ! -e /dev/media0 ]; then
    echo "[-] /dev/media0 not found. Camera drivers are not active."
    exit 1
fi

MEDIA_DEV="/dev/media0"

# 0. Keep sensors out of runtime suspend to avoid reset glitches across back-to-back streams
for i2c_dev in 4-0036 3-0060 3-0010; do
    if [ -w "/sys/bus/i2c/devices/$i2c_dev/power/control" ]; then
        echo on > "/sys/bus/i2c/devices/$i2c_dev/power/control"
    fi
done

# 1. Reset media controller links
media-ctl -d "$MEDIA_DEV" -r

# 2. Configure proven physical CSIPHY -> CSID -> VFE RDI0 routes on Surface Pro X SQ2
# Front RGB 5 MP (ov5693 4-0036 -> csiphy0 -> csid0 -> vfe0_rdi0 -> /dev/video0)
media-ctl -d "$MEDIA_DEV" -l '"msm_csiphy0":1->"msm_csid0":0[1]'
media-ctl -d "$MEDIA_DEV" -l '"msm_csid0":1->"msm_vfe0_rdi0":0[1]'

# Rear RGB 13 MP (ov13858 3-0010 -> csiphy2 -> csid1 -> vfe1_rdi0 -> /dev/video4)
media-ctl -d "$MEDIA_DEV" -l '"msm_csiphy2":1->"msm_csid1":0[1]'
media-ctl -d "$MEDIA_DEV" -l '"msm_csid1":1->"msm_vfe1_rdi0":0[1]'

# Front IR VGA (ov7251 3-0060 -> csiphy3 -> csid3 -> vfe3_rdi0 -> /dev/video12)
media-ctl -d "$MEDIA_DEV" -l '"msm_csiphy3":1->"msm_csid3":0[1]'
media-ctl -d "$MEDIA_DEV" -l '"msm_csid3":1->"msm_vfe3_rdi0":0[1]'

# 3. Sensor native formats
media-ctl -d "$MEDIA_DEV" -V '"ov5693 4-0036":0[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"ov13858 3-0010":0[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"ov7251 3-0060":0[fmt:Y10_1X10/640x480]'

# 4. Internal CAMSS pad formats
# Front RGB (OV5693: SBGGR10_1X10 2592x1944)
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy0":0[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy0":1[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid0":0[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid0":1[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe0_rdi0":0[fmt:SBGGR10_1X10/2592x1944]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe0_rdi0":1[fmt:SBGGR10_1X10/2592x1944]'

# Rear RGB (OV13858: SGRBG10_1X10 4224x3136)
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy2":0[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy2":1[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid1":0[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid1":1[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe1_rdi0":0[fmt:SGRBG10_1X10/4224x3136]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe1_rdi0":1[fmt:SGRBG10_1X10/4224x3136]'

# Front IR (OV7251: CSID3 unpacks Y10_1X10 in hardware to 16-bit PLAIN16 Y10_2X8_PADHI_LE for OpenCV/Howdy)
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy3":0[fmt:Y10_1X10/640x480]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csiphy3":1[fmt:Y10_1X10/640x480]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid3":0[fmt:Y10_1X10/640x480]'
media-ctl -d "$MEDIA_DEV" -V '"msm_csid3":1[fmt:Y10_2X8_PADHI_LE/640x480]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe3_rdi0":0[fmt:Y10_2X8_PADHI_LE/640x480]'
media-ctl -d "$MEDIA_DEV" -V '"msm_vfe3_rdi0":1[fmt:Y10_2X8_PADHI_LE/640x480]'

# 5. Video capture node default formats
v4l2-ctl -d /dev/video0 --set-fmt-video=width=2592,height=1944,pixelformat=pBAA
v4l2-ctl -d /dev/video4 --set-fmt-video=width=4224,height=3136,pixelformat=pgAA
v4l2-ctl -d /dev/video12 --set-fmt-video=width=640,height=480,pixelformat='Y10 '

# 6. Tuned exposure / blanking / gain defaults per sensor
for sys_sd in /sys/class/video4linux/v4l-subdev*; do
    [ -e "$sys_sd/name" ] || continue
    sd_name="$(cat "$sys_sd/name")"
    sd_dev="/dev/$(basename "$sys_sd")"
    case "$sd_name" in
        "ov5693 4-0036")
            v4l2-ctl -d "$sd_dev" --set-ctrl=vertical_blanking=1200 || true
            v4l2-ctl -d "$sd_dev" --set-ctrl=digital_gain=1350,analogue_gain=32,exposure=2400 || true
            ;;
        "ov13858 3-0010")
            v4l2-ctl -d "$sd_dev" --set-ctrl=vertical_blanking=1600 || true
            v4l2-ctl -d "$sd_dev" --set-ctrl=digital_gain=2048,analogue_gain=768,exposure=3200 || true
            ;;
        "ov7251 3-0060")
            v4l2-ctl -d "$sd_dev" --set-ctrl=gain=32,exposure=550,horizontal_flip=0,vertical_flip=0 || true
            ;;
    esac
done

# 7. Stable device symlinks
ln -sfn /dev/video0 /dev/video-front
ln -sfn /dev/video4 /dev/video-rear
ln -sfn /dev/video12 /dev/video-ir

echo "  [+] Front RGB ready: /dev/video-front -> /dev/video0  (2592x1944 SBGGR10P)"
echo "  [+] Rear  RGB ready: /dev/video-rear  -> /dev/video4  (4224x3136 SGRBG10P)"
echo "  [+] Front IR  ready: /dev/video-ir    -> /dev/video12 (640x480 Y10)"
