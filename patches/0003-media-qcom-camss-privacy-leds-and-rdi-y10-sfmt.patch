+	int i, ret;
 
 	entity = &vdev->entity;
-	while (1) {
+	while (n_subdevs < ARRAY_SIZE(subdevs)) {
 		pad = &entity->pads[0];
 		if (!(pad->flags & MEDIA_PAD_FL_SINK))
 			break;
@@ -317,14 +331,21 @@
 			break;
 
 		entity = pad->entity;
-		subdev = media_entity_to_v4l2_subdev(entity);
-
-		ret = v4l2_subdev_call(subdev, video, s_stream, 0);
+		subdevs[n_subdevs++] = media_entity_to_v4l2_subdev(entity);
+	}
 
-		if (ret) {
-			dev_err(video->camss->dev, "Video pipeline stop failed: %d\n", ret);
-			return;
-		}
+	/*
+	 * Stop subdevices in sink-to-source order (VFE -> CSID -> CSIPHY -> sensor)
+	 * so VFE latches WM_CFG = 0 and REG_UPDATE_CMD on the next EOF/SOF while
+	 * upstream subdevices are still active, and always continue shutting down
+	 * remaining subdevices even if one returns a non-fatal error.
+	 */
+	for (i = 0; i < n_subdevs; i++) {
+		ret = v4l2_subdev_call(subdevs[i], video, s_stream, 0);
+		if (ret && ret != -ENOIOCTLCMD)
+			dev_warn(video->camss->dev,
+				 "Video pipeline stop subdev %s warning: %d\n",
+				 subdevs[i]->name, ret);
 	}
 
 	video_device_pipeline_stop(vdev);
