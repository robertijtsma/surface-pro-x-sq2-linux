 		.name	= "spi_hid",
 		.owner	= THIS_MODULE,
 		.of_match_table = of_match_ptr(spi_hid_of_match),
+		.pm	= &spi_hid_pm_ops,
 	},
 	.probe		= spi_hid_probe,
 	.remove		= spi_hid_remove,
