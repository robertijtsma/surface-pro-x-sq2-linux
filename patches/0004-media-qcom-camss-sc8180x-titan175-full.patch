+	} else if (csiphy_id == 2) {
+		if (on)
+			camss->rear_led_refcnt++;
+		else if (camss->rear_led_refcnt > 0)
+			camss->rear_led_refcnt--;
+
+		if (camss->privacy_led_rear)
+			gpiod_set_value_cansleep(camss->privacy_led_rear,
+						 camss->rear_led_refcnt > 0 ? 1 : 0);
+	}
+
+	mutex_unlock(&camss->privacy_led_lock);
