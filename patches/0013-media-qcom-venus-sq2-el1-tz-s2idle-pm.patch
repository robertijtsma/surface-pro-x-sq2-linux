+int venus_hfi_tz_suspend(struct venus_core *core)
+{
+	struct venus_hfi_device *hdev = to_hfi_priv(core);
+	int ret;
+
+	if (!IS_SQ2_HFI(core) || !hdev || !core->sq2_secure_active ||
+	    core->sq2_no_tz_active || test_bit(0, &core->sys_error))
+		return -EINVAL;
+
+	mutex_lock(&hdev->lock);
+	if (!hdev->power_enabled) {
+		mutex_unlock(&hdev->lock);
+		return 0;
+	}
+
+	ret = qcom_pas_set_remote_state(0, 0);
+	dev_info(core->dev, "SQ2_TZ_PM set_remote_state(0, 0) ret=%d\n", ret);
+	if (ret) {
+		mutex_unlock(&hdev->lock);
+		return ret;
+	}
+
+	ret = venus_halt_axi(hdev);
+	if (ret) {
+		dev_err(core->dev, "SQ2_TZ_PM halt_axi ret=%d\n", ret);
+		mutex_unlock(&hdev->lock);
+		return ret;
+	}
+
+	hdev->power_enabled = false;
+	hdev->suspended = true;
+	mutex_unlock(&hdev->lock);
+	return 0;
+}
+
+int venus_hfi_tz_resume(struct venus_core *core)
+{
+	struct venus_hfi_device *hdev = to_hfi_priv(core);
+	u32 axi_halt, arg0_pre, arg0_post, cpu_post;
+	int ret, raw;
+
+	if (!IS_SQ2_HFI(core) || !hdev || !core->sq2_secure_active ||
+	    core->sq2_no_tz_active || test_bit(0, &core->sys_error))
+		return -EINVAL;
+
+	mutex_lock(&hdev->lock);
+	if (hdev->power_enabled) {
+		mutex_unlock(&hdev->lock);
+		return 0;
+	}
+
+	axi_halt = readl(core->wrapper_base + WRAPPER_CPU_AXI_HALT);
+	if (axi_halt & WRAPPER_CPU_AXI_HALT_HALT) {
+		writel(axi_halt & ~WRAPPER_CPU_AXI_HALT_HALT,
+		       core->wrapper_base + WRAPPER_CPU_AXI_HALT);
+	}
+	arg0_pre = readl(core->cpu_cs_base + CPU_CS_SCIACMDARG0);
+
+	raw = qcom_pas_set_remote_state(1, 0);
+	ret = (raw == -EINVAL) ? 0 : raw;
+	if (ret) {
+		dev_err(core->dev, "SQ2_TZ_PM set_remote_state(1, 0) ret=%d\n", raw);
+		mutex_unlock(&hdev->lock);
+		return ret;
+	}
+
+	ret = venus_run(hdev);
+	arg0_post = readl(core->cpu_cs_base + CPU_CS_SCIACMDARG0);
+	cpu_post = readl(core->wrapper_base + WRAPPER_CPU_STATUS);
+	dev_info(core->dev,
+		 "SQ2_TZ_PM resume axi_halt=0x%x arg0=0x%x->0x%x cpu=0x%x remote=%d run=%d\n",
+		 axi_halt, arg0_pre, arg0_post, cpu_post, raw, ret);
+	if (ret) {
+		qcom_pas_set_remote_state(0, 0);
+		mutex_unlock(&hdev->lock);
+		return ret;
+	}
+
+	hdev->power_enabled = true;
+	hdev->suspended = false;
+	mutex_unlock(&hdev->lock);
+	return 0;
+}
