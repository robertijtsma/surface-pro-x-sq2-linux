+static int venus_sq2_pm_stop_tz(struct venus_core *core)
+{
+ int ret;
+ if (sq2_tz_pm_mode == 2) {
+  cancel_delayed_work_sync(&core->work);
+  venus_hfi_prepare_system_stop(core);
+  ret = venus_sq2_pm_result(core, "tz-stop:shutdown", venus_sq2_stop_core(core));
+  if (!ret) {
+   sq2_tz_stopped = true;
+   WRITE_ONCE(sq2_pm_stage, "tz-stop:stopped");
+  }
+  return ret;
+ }
+ cancel_delayed_work_sync(&core->work);
+ ret = venus_sq2_pm_result(core, "tz-stop:prepare-pc",
+  venus_hfi_prepare_system_stop(core));
+ if (ret) return ret;
+ ret = venus_sq2_pm_result(core, "tz-stop:irq-disable",
+  sq2_venus_platform_irq(core->sq2_platform, false));
+ if (ret) return ret;
+ cancel_delayed_work_sync(&core->work);
+ ret = venus_sq2_pm_result(core, "tz-stop:recheck-idle", venus_sq2_pm_idle(core));
+ if (ret) {
+  if (ret == -EBUSY) {
+   ret = venus_sq2_pm_result(core, "tz-stop:busy-irq-restore",
+    sq2_venus_platform_irq(core->sq2_platform, true));
+   if (!ret) return SQ2_PM_STOP_UNCHANGED_BUSY;
+  }
+  return ret;
+ }
+ ret = venus_sq2_pm_result(core, "tz-stop:hfi-tz-suspend",
+  venus_hfi_tz_suspend(core));
+ if (ret) {
+  sq2_venus_platform_irq(core->sq2_platform, true);
+  return SQ2_PM_STOP_UNCHANGED_BUSY;
+ }
+ ret = venus_sq2_pm_result(core, "tz-stop:power-quiet",
+  sq2_venus_platform_system_quiet_tz(core->sq2_platform));
+ if (!ret)
+  WRITE_ONCE(sq2_pm_stage, "tz-stop:quiet");
+ return ret;
+}
+
+static int venus_sq2_pm_start_tz(struct venus_core *core)
+{
+ int ret;
+ if (sq2_tz_stopped) return 0;
+ ret = venus_sq2_pm_result(core, "tz-start:power-restore",
+  sq2_venus_platform_system_restore_tz(core->sq2_platform, sq2_tz_resume_pulse));
+ if (ret) goto tz_fail;
+ if (sq2_tz_resume_reinit)
+  venus_hfi_queues_reinit(core);
+ ret = venus_sq2_pm_result(core, "tz-start:hfi-tz-resume",
+  venus_hfi_tz_resume(core));
+ if (ret) goto tz_fail;
+ ret = venus_sq2_pm_result(core, "tz-start:irq-enable",
+  sq2_venus_platform_irq(core->sq2_platform, true));
+ if (ret) goto tz_fail;
+ if (sq2_tz_resume_reinit) {
+  core->state = CORE_UNINIT;
+  ret = venus_sq2_pm_result(core, "tz-start:hfi-init",
+   hfi_core_init(core));
+  if (ret) goto tz_fail;
+ }
+ if (test_bit(0, &core->sys_error)) {
+  ret = venus_sq2_pm_result(core, "tz-start:sys-error", -EIO);
+  goto tz_fail;
+ }
+ WRITE_ONCE(sq2_pm_stage, "tz-start:ready");
+ return 0;
+tz_fail:
+ sq2_venus_platform_irq(core->sq2_platform, false);
+ cancel_delayed_work_sync(&core->work);
+ set_bit(0, &core->sys_error);
+ dev_err(core->dev, "SQ2_TZ_PM resume failed ret=%d; quarantined until reboot\n", ret);
+ return ret;
+}
