From: robertijtsma <37256770+robertijtsma@users.noreply.github.com>
Subject: [PATCH 1/4] media: i2c: ov13858: add DT support, reset GPIO, flips, and usable gain defaults

Add Device Tree compatible matching ("ovti,ov13858"), optional reset GPIO
handling, V4L2_CID_HFLIP / V4L2_CID_VFLIP controls, optional MIPI_CTRL00
(0x4800) override parameter, and non-zero minimum/default exposure and
analog/digital gain values for the rear 13 MP OV13858 sensor on Microsoft
Surface Pro X (SC8180X / SQ2).

Base: Linux v7.3

Signed-off-by: robertijtsma <37256770+robertijtsma@users.noreply.github.com>
---
--- a/drivers/media/i2c/ov13858.c
+++ b/drivers/media/i2c/ov13858.c
@@ -3,14 +3,23 @@
 
 #include <linux/acpi.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/pm_runtime.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-fwnode.h>
 
+static int mipi_ctrl00 = -1;
+module_param(mipi_ctrl00, int, 0644);
+MODULE_PARM_DESC(mipi_ctrl00, "Override OV13858 reg 0x4800 MIPI_CTRL00 (-1 = keep default 0x00)");
+
+#define OV13858_REG_MIPI_CTRL00		0x4800
+
 #define OV13858_REG_VALUE_08BIT		1
 #define OV13858_REG_VALUE_16BIT		2
 #define OV13858_REG_VALUE_24BIT		3
@@ -58,24 +67,30 @@
 #define OV13858_REG_EXPOSURE		0x3500
 #define OV13858_EXPOSURE_MIN		4
 #define OV13858_EXPOSURE_STEP		1
-#define OV13858_EXPOSURE_DEFAULT	0x640
+#define OV13858_EXPOSURE_DEFAULT	0xbb8
 
 /* Analog gain control */
 #define OV13858_REG_ANALOG_GAIN		0x3508
-#define OV13858_ANA_GAIN_MIN		0
+#define OV13858_ANA_GAIN_MIN		0x80
 #define OV13858_ANA_GAIN_MAX		0x1fff
 #define OV13858_ANA_GAIN_STEP		1
-#define OV13858_ANA_GAIN_DEFAULT	0x80
+#define OV13858_ANA_GAIN_DEFAULT	0x400
 
 /* Digital gain control */
 #define OV13858_REG_B_MWB_GAIN		0x5100
 #define OV13858_REG_G_MWB_GAIN		0x5102
 #define OV13858_REG_R_MWB_GAIN		0x5104
-#define OV13858_DGTL_GAIN_MIN		0
+#define OV13858_DGTL_GAIN_MIN		0x400
 #define OV13858_DGTL_GAIN_MAX		16384	/* Max = 16 X */
-#define OV13858_DGTL_GAIN_DEFAULT	1024	/* Default gain = 1 X */
+#define OV13858_DGTL_GAIN_DEFAULT	3072	/* Default gain = 3 X */
 #define OV13858_DGTL_GAIN_STEP		1	/* Each step = 1/1024 */
 
+/* Readout direction */
+#define OV13858_REG_FORMAT1		0x3820
+#define OV13858_FORMAT1_VFLIP		BIT(4)
+/* Horizontal flip, active low: every mode table sets this bit */
+#define OV13858_FORMAT1_HFLIP_N		BIT(3)
+
 /* Test Pattern Control */
 #define OV13858_REG_TEST_PATTERN	0x4503
 #define OV13858_TEST_PATTERN_ENABLE	BIT(7)
@@ -1031,6 +1046,7 @@
 struct ov13858 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -1042,6 +1058,8 @@
 	struct v4l2_ctrl *vblank;
 	struct v4l2_ctrl *hblank;
 	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
 
 	/* Current mode */
 	const struct ov13858_mode *cur_mode;
@@ -1208,6 +1226,31 @@
 				 OV13858_REG_VALUE_08BIT, val);
 }
 
+static int ov13858_update_flips(struct ov13858 *ov13858)
+{
+	u32 val;
+	int ret;
+
+	ret = ov13858_read_reg(ov13858, OV13858_REG_FORMAT1,
+			       OV13858_REG_VALUE_08BIT, &val);
+	if (ret)
+		return ret;
+
+	if (ov13858->vflip->val)
+		val |= OV13858_FORMAT1_VFLIP;
+	else
+		val &= ~OV13858_FORMAT1_VFLIP;
+
+	/* The mirror bit is active low, as it is on ov13b10. */
+	if (ov13858->hflip->val)
+		val &= ~OV13858_FORMAT1_HFLIP_N;
+	else
+		val |= OV13858_FORMAT1_HFLIP_N;
+
+	return ov13858_write_reg(ov13858, OV13858_REG_FORMAT1,
+				 OV13858_REG_VALUE_08BIT, val);
+}
+
 static int ov13858_set_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct ov13858 *ov13858 = container_of(ctrl->handler,
@@ -1254,6 +1297,10 @@
 					ov13858->cur_mode->height
 					  + ctrl->val);
 		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = ov13858_update_flips(ov13858);
+		break;
 	case V4L2_CID_TEST_PATTERN:
 		ret = ov13858_enable_test_pattern(ov13858, ctrl->val);
 		break;
@@ -1421,6 +1468,7 @@
 			__func__);
 		return ret;
 	}
+	usleep_range(5000, 6000);
 
 	/* Setup PLL */
 	link_freq_index = ov13858->cur_mode->link_freq_index;
@@ -1444,9 +1492,36 @@
 	if (ret)
 		return ret;
 
-	return ov13858_write_reg(ov13858, OV13858_REG_MODE_SELECT,
-				 OV13858_REG_VALUE_08BIT,
-				 OV13858_MODE_STREAMING);
+	{
+		u32 orig_4800 = 0, mode_val = 0, mipi_val = 0;
+
+		ov13858_read_reg(ov13858, OV13858_REG_MIPI_CTRL00,
+				 OV13858_REG_VALUE_08BIT, &orig_4800);
+		if (mipi_ctrl00 >= 0) {
+			ret = ov13858_write_reg(ov13858, OV13858_REG_MIPI_CTRL00,
+						OV13858_REG_VALUE_08BIT,
+						(u32)(mipi_ctrl00 & 0xff));
+			if (ret)
+				dev_err(ov13858->dev,
+					"write 0x4800 failed: %d\n",
+					ret);
+		}
+
+		ret = ov13858_write_reg(ov13858, OV13858_REG_MODE_SELECT,
+					OV13858_REG_VALUE_08BIT,
+					OV13858_MODE_STREAMING);
+		if (ret)
+			return ret;
+
+		ov13858_read_reg(ov13858, OV13858_REG_MODE_SELECT,
+				 OV13858_REG_VALUE_08BIT, &mode_val);
+		ov13858_read_reg(ov13858, OV13858_REG_MIPI_CTRL00,
+				 OV13858_REG_VALUE_08BIT, &mipi_val);
+		dev_dbg(ov13858->dev,
+			"streaming started: MODE_SELECT=0x%02x, MIPI_0x4800=0x%02x (orig=0x%02x)\n",
+			mode_val, mipi_val, orig_4800);
+		return 0;
+	}
 }
 
 /* Stop streaming */
@@ -1480,6 +1555,13 @@
 		pm_runtime_put(ov13858->dev);
 	}
 
+	/*
+	 * Do not let the flips change while streaming. ov13858->mutex is the
+	 * control handler's own lock and is held here, hence the __ form.
+	 */
+	__v4l2_ctrl_grab(ov13858->hflip, enable);
+	__v4l2_ctrl_grab(ov13858->vflip, enable);
+
 	mutex_unlock(&ov13858->mutex);
 
 	return ret;
@@ -1618,6 +1700,12 @@
 			  OV13858_DGTL_GAIN_MIN, OV13858_DGTL_GAIN_MAX,
 			  OV13858_DGTL_GAIN_STEP, OV13858_DGTL_GAIN_DEFAULT);
 
+	ov13858->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov13858_ctrl_ops,
+					   V4L2_CID_HFLIP, 0, 1, 1, 0);
+	ov13858->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov13858_ctrl_ops,
+					   V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &ov13858->hflip);
+
 	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &ov13858_ctrl_ops,
 				     V4L2_CID_TEST_PATTERN,
 				     ARRAY_SIZE(ov13858_test_pattern_menu) - 1,
@@ -1674,9 +1762,24 @@
 
 	freq = clk_get_rate(ov13858->clk);
 	if (freq != 19200000)
-		return dev_err_probe(ov13858->dev, -EINVAL,
-				     "external clock %lu is not supported\n",
-				     freq);
+		dev_warn(ov13858->dev,
+			 "external clock %lu differs from expected 19200000\n",
+			 freq);
+
+	ov13858->reset_gpio = devm_gpiod_get_optional(ov13858->dev, "reset",
+						      GPIOD_OUT_LOW);
+	if (IS_ERR(ov13858->reset_gpio))
+		return dev_err_probe(ov13858->dev, PTR_ERR(ov13858->reset_gpio),
+				     "failed to get reset gpio\n");
+	if (ov13858->reset_gpio) {
+		gpiod_set_value_cansleep(ov13858->reset_gpio, 1);
+		usleep_range(2000, 3000);
+	}
+
+	ret = clk_prepare_enable(ov13858->clk);
+	if (ret)
+		dev_warn(ov13858->dev, "clk_prepare_enable failed: %d\n", ret);
+	usleep_range(5000, 6000);
 
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&ov13858->sd, client, &ov13858_subdev_ops);
@@ -1744,6 +1847,7 @@
 	ov13858_free_controls(ov13858);
 
 	pm_runtime_disable(ov13858->dev);
+	clk_disable_unprepare(ov13858->clk);
 }
 
 static const struct i2c_device_id ov13858_id_table[] = {
@@ -1753,6 +1857,12 @@
 
 MODULE_DEVICE_TABLE(i2c, ov13858_id_table);
 
+static const struct of_device_id ov13858_of_match[] = {
+	{ .compatible = "ovti,ov13858" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov13858_of_match);
+
 #ifdef CONFIG_ACPI
 static const struct acpi_device_id ov13858_acpi_ids[] = {
 	{"OVTID858"},
@@ -1765,6 +1875,7 @@
 static struct i2c_driver ov13858_i2c_driver = {
 	.driver = {
 		.name = "ov13858",
+		.of_match_table = of_match_ptr(ov13858_of_match),
 		.acpi_match_table = ACPI_PTR(ov13858_acpi_ids),
 	},
 	.probe = ov13858_probe,
