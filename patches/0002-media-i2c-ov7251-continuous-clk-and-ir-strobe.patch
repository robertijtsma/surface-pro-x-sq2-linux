From: robertijtsma <37256770+robertijtsma@users.noreply.github.com>
Subject: [PATCH 2/4] media: i2c: ov7251: enable continuous MIPI clock and automatic IR strobe LED

Configure MIPI_CTRL00 (0x4800 = 0x24) for reliable LP->HS transitions on
Qualcomm SC8180X CSIPHY3, use runtime PM autosuspend to avoid reset
glitches across back-to-back streams, and automatically drive the sensor's
hardware STROBE pin (0x3b81/0x3b8e..0x3b8f/0x3005) on stream start/stop so
the 850 nm Windows Hello IR illuminator activates only while streaming.

Base: Linux v7.3

Signed-off-by: robertijtsma <37256770+robertijtsma@users.noreply.github.com>
---
--- a/drivers/media/i2c/ov7251.c
+++ b/drivers/media/i2c/ov7251.c
@@ -26,6 +26,22 @@
 #define OV7251_SC_MODE_SELECT_SW_STANDBY	0x0
 #define OV7251_SC_MODE_SELECT_STREAMING		0x1
 
+static int ir_strobe = 1;
+module_param(ir_strobe, int, 0644);
+MODULE_PARM_DESC(ir_strobe, "OV7251 IR strobe mode: 0=off, 1=HW strobe (default), 2=manual HIGH, 3=HW strobe+PWM, 4=manual strobe+PWM HIGH");
+
+static int strobe_pattern = 0xff;
+module_param(strobe_pattern, int, 0644);
+MODULE_PARM_DESC(strobe_pattern, "OV7251 reg 0x3b81 frame pattern mask (default 0xff)");
+
+static int strobe_span = 0x0200;
+module_param(strobe_span, int, 0644);
+MODULE_PARM_DESC(strobe_span, "OV7251 reg 0x3b8e..0x3b8f strobe_frame_span (default 0x0200)");
+
+static int strobe_pol = -1;
+module_param(strobe_pol, int, 0644);
+MODULE_PARM_DESC(strobe_pol, "Override OV7251 reg 0x3b96 (-1 = keep default 0x40)");
+
 #define OV7251_CHIP_ID_HIGH		0x300a
 #define OV7251_CHIP_ID_HIGH_BYTE	0x77
 #define OV7251_CHIP_ID_LOW		0x300b
@@ -354,6 +370,7 @@
 	{ 0x4501, 0x48 },
 	{ 0x4600, 0x00 },
 	{ 0x4601, 0x4e },
+	{ 0x4800, 0x24 },
 	{ 0x4801, 0x0f },
 	{ 0x4806, 0x0f },
 	{ 0x4819, 0xaa },
@@ -482,6 +499,7 @@
 	{ 0x4501, 0x48 },
 	{ 0x4600, 0x00 },
 	{ 0x4601, 0x4e },
+	{ 0x4800, 0x24 },
 	{ 0x4801, 0x0f },
 	{ 0x4806, 0x0f },
 	{ 0x4819, 0xaa },
@@ -610,6 +628,7 @@
 	{ 0x4501, 0x48 },
 	{ 0x4600, 0x00 },
 	{ 0x4601, 0x4e },
+	{ 0x4800, 0x24 },
 	{ 0x4801, 0x0f },
 	{ 0x4806, 0x0f },
 	{ 0x4819, 0xaa },
@@ -941,6 +960,8 @@
 		return ret;
 	}
 
+	usleep_range(5000, 10000);
+
 	return ret;
 }
 
@@ -1072,7 +1093,8 @@
 		break;
 	}
 
-	pm_runtime_put(ov7251->dev);
+	pm_runtime_mark_last_busy(ov7251->dev);
+	pm_runtime_put_autosuspend(ov7251->dev);
 
 	return ret;
 }
@@ -1337,12 +1359,15 @@
 {
 	struct ov7251 *ov7251 = to_ov7251(subdev);
 	int ret;
+	u8 reg_val = 0;
 
+	dev_dbg(ov7251->dev, "s_stream(%d) called\n", enable);
 	mutex_lock(&ov7251->lock);
 
 	if (enable) {
 		ret = pm_runtime_resume_and_get(ov7251->dev);
 		if (ret) {
+			dev_err(ov7251->dev, "pm_runtime_resume failed: %d\n", ret);
 			mutex_unlock(&ov7251->lock);
 			return ret;
 		}
@@ -1362,26 +1387,70 @@
 				ov7251->current_mode->height);
 			goto err_power_down;
 		}
+		u8 mipi_ctrl = 0;
 		ret = __v4l2_ctrl_handler_setup(&ov7251->ctrls);
 		if (ret < 0) {
 			dev_err(ov7251->dev, "could not sync v4l2 controls\n");
 			goto err_power_down;
 		}
+		ret = ov7251_write_reg(ov7251, 0x4800, 0x24);
+		if (ret)
+			dev_err(ov7251->dev, "write 0x4800 failed: %d\n", ret);
+
+		if (ir_strobe > 0) {
+			if (strobe_pattern >= 0)
+				ov7251_write_reg(ov7251, 0x3b81, (u8)(strobe_pattern & 0xff));
+			if (strobe_span >= 0) {
+				ov7251_write_reg(ov7251, 0x3b8e, (u8)((strobe_span >> 8) & 0xff));
+				ov7251_write_reg(ov7251, 0x3b8f, (u8)(strobe_span & 0xff));
+			}
+			if (strobe_pol >= 0)
+				ov7251_write_reg(ov7251, 0x3b96, (u8)(strobe_pol & 0xff));
+
+			if (ir_strobe == 1) {
+				ov7251_write_reg(ov7251, 0x3027, 0x00);
+				ov7251_write_reg(ov7251, 0x3005, 0x08);
+			} else if (ir_strobe == 2) {
+				ov7251_write_reg(ov7251, 0x3009, 0x08);
+				ov7251_write_reg(ov7251, 0x3027, 0x08);
+				ov7251_write_reg(ov7251, 0x3005, 0x08);
+			} else if (ir_strobe == 3) {
+				ov7251_write_reg(ov7251, 0x3027, 0x00);
+				ov7251_write_reg(ov7251, 0x3005, 0x0c);
+			} else if (ir_strobe == 4) {
+				ov7251_write_reg(ov7251, 0x3009, 0x0c);
+				ov7251_write_reg(ov7251, 0x3027, 0x0c);
+				ov7251_write_reg(ov7251, 0x3005, 0x0c);
+			}
+		}
+
 		ret = ov7251_write_reg(ov7251, OV7251_SC_MODE_SELECT,
 				       OV7251_SC_MODE_SELECT_STREAMING);
-		if (ret)
+		if (ret) {
+			dev_err(ov7251->dev, "write MODE_SELECT failed: %d\n", ret);
 			goto err_power_down;
+		}
+		ov7251_read_reg(ov7251, OV7251_SC_MODE_SELECT, &reg_val);
+		ov7251_read_reg(ov7251, 0x4800, &mipi_ctrl);
+		dev_dbg(ov7251->dev, "streaming started: MODE_SELECT=0x%02x, MIPI_0x4800=0x%02x, ir_strobe=%d\n",
+			reg_val, mipi_ctrl, ir_strobe);
 	} else {
+		ov7251_write_reg(ov7251, 0x3005, 0x00);
+		ov7251_write_reg(ov7251, 0x3027, 0x00);
+		ov7251_write_reg(ov7251, 0x3009, 0x00);
 		ret = ov7251_write_reg(ov7251, OV7251_SC_MODE_SELECT,
 				       OV7251_SC_MODE_SELECT_SW_STANDBY);
-		pm_runtime_put(ov7251->dev);
+		dev_dbg(ov7251->dev, "streaming stopped, returned to standby\n");
+		pm_runtime_mark_last_busy(ov7251->dev);
+		pm_runtime_put_autosuspend(ov7251->dev);
 	}
 
 	mutex_unlock(&ov7251->lock);
 	return ret;
 
 err_power_down:
-	pm_runtime_put(ov7251->dev);
+	pm_runtime_mark_last_busy(ov7251->dev);
+	pm_runtime_put_autosuspend(ov7251->dev);
 	mutex_unlock(&ov7251->lock);
 	return ret;
 }
