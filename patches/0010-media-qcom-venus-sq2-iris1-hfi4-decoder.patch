+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_VENUS_FW_H
+#define SQ2_VENUS_FW_H
+struct device;
+struct sq2_venus_fw;
+/* Independent owner survives loss of a core/device pointer on failed probe.
+ * On failure *out can be non-NULL: allocation is quarantined until reboot.
+ * Does not handle HFI/IRQ/clock lifetime; callers must retain those separately.
+ */
+/* A non-NULL powered MMIO base explicitly selects the EL2 no-TZ lab candidate. */
+int sq2_venus_fw_boot(struct device *dev, struct sq2_venus_fw **out, bool pil_gap,
+                     void __iomem *no_tz_base);
+int sq2_venus_fw_shutdown(struct sq2_venus_fw **owner);
+int sq2_venus_fw_probe_gap(void);
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-lifetime.h b/drivers/media/platform/qcom/venus/sq2-venus-lifetime.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-lifetime.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-lifetime.h	2026-11-20 21:12:16.422360202 +0100
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_VENUS_LIFETIME_H
+#define SQ2_VENUS_LIFETIME_H
+/* Shared policy used by the real resource owner and host fault tests. */
+struct sq2_venus_lifetime {
+ bool secure_touched, quarantined;
+ int stop_error;
+};
+static int sq2_venus_lifetime_begin(struct sq2_venus_lifetime *s)
+{
+ if (s->quarantined || s->secure_touched)
+  return -EBUSY;
+ s->secure_touched = true;
+ return 0;
+}
+static int sq2_venus_lifetime_end(struct sq2_venus_lifetime *s, int ret)
+{
+ if (s->quarantined)
+  return s->stop_error;
+ if (!s->secure_touched)
+  return -EINVAL;
+ if (ret) {
+  s->quarantined = true;
+  s->stop_error = ret;
+  return ret;
+ }
+ s->secure_touched = false;
+ return 0;
+}
+static bool sq2_venus_lifetime_releasable(const struct sq2_venus_lifetime *s)
+{
+ return !s->secure_touched && !s->quarantined;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-no-tz.h b/drivers/media/platform/qcom/venus/sq2-venus-no-tz.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-no-tz.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-no-tz.h	2026-11-20 21:12:16.428512339 +0100
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Fixed SC8180X candidate from QcSkExt8180 a090/b4f8/b930. Call only with
+ * power held and the checked firmware mapped at IOVA 0. Never read TZ ranges.
+ */
+#ifndef SQ2_VENUS_NO_TZ_H
+#define SQ2_VENUS_NO_TZ_H
+static int sq2_no_tz_reset_held(void __iomem *base)
+{
+ u32 value = readl(base + 0xe3000);
+ return value != ~0U && (value & BIT(4)) ? 0 : -EBUSY;
+}
+
+static int sq2_no_tz_stop_cpu(void __iomem *base)
+{
+ u32 value = readl(base + 0xe3000);
+ if (value == ~0U) return -EIO;
+ writel(value | BIT(4), base + 0xe3000);
+ udelay(1);
+ return sq2_no_tz_reset_held(base);
+}
+
+static int sq2_no_tz_start_cpu(void __iomem *base, u32 span)
+{
+ u32 value;
+ int ret;
+ if (span != 0x500000) return -EINVAL;
+ ret = sq2_no_tz_reset_held(base);
+ if (ret) return ret;
+ udelay(1);
+ /* Unlike the intermediate Windows PIL state, Linux no-TZ must give the
+  * firmware a usable final range before CTRL_INIT builds its own MMU table. */
+ writel(0, base + 0xe1028);
+ writel(span, base + 0xe102c);
+ writel(0, base + 0xe1020);
+ writel(span, base + 0xe1024);
+ writel(span, base + 0xe1030);
+ writel(span, base + 0xe1034);
+ writel(1, base + 0xe1084);
+ writel(3, base + 0xe3084);
+ writel(0x540, base + 0xe3050);
+ writel(0x10e, base + 0xe3054);
+ writel(0x2e, base + 0xe3058);
+ writel(0xed8, base + 0xe306c);
+ writel(0x3138, base + 0xe3070);
+ writel(0x640, base + 0xe3078);
+ writel(readl(base + 0xe3088) & ~1U, base + 0xe3088);
+ writel(readl(base + 0xe308c) & ~1U, base + 0xe308c);
+ writel(readl(base + 0xe304c) | 1U, base + 0xe304c);
+ writel(readl(base + 0xe2010) & ~BIT(4), base + 0xe2010);
+ writel(readl(base + 0xe2000) & ~BIT(4), base + 0xe2000);
+ value = readl(base + 0xe3000);
+ if (value == ~0U || !(value & BIT(4))) return -EIO;
+ writel(value & ~BIT(4), base + 0xe3000);
+ value = readl(base + 0xe3000);
+ return value == ~0U || (value & BIT(4)) ? -EIO : 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-platform.c b/drivers/media/platform/qcom/venus/sq2-venus-platform.c
--- a/drivers/media/platform/qcom/venus/sq2-venus-platform.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-platform.c	2026-11-20 21:12:16.118350040 +0100
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Independent core/MMIO/IRQ owner. Not yet a runnable platform backend:
+ * power/reset/ICC and core.c probe/recovery/remove dispatch are still pending.
+ */
+#ifndef SQ2_VENUS_PLATFORM_HOST_TEST
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/interrupt.h>
+#include <linux/slab.h>
+#include "core.h"
+#include "hfi.h"
+#endif
+#include "sq2-venus-platform.h"
+#include "sq2-venus-lifetime.h"
+#include "sq2-venus-power.h"
+
+struct sq2_venus_platform {
+ struct venus_core core;
+ struct sq2_venus_lifetime lifetime;
+ struct sq2_venus_power *power;
+ resource_size_t start, size;
+ bool region, irq_requested, irq_enabled;
+};
+
+struct venus_core *sq2_venus_platform_core(struct sq2_venus_platform *owner)
+{
+ return owner ? &owner->core : NULL;
+}
+
+int sq2_venus_platform_alloc(struct platform_device *pdev,
+                            struct sq2_venus_platform **out)
+{
+ struct sq2_venus_platform *o;
+ struct resource *r;
+ int ret;
+ if (!out || *out)
+  return -EINVAL;
+ r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+ if (!r || !resource_size(r))
+  return -ENODEV;
+ o = kzalloc(sizeof(*o), GFP_KERNEL);
+ if (!o)
+  return -ENOMEM;
+ if (!try_module_get(THIS_MODULE)) {
+  kfree(o);
+  return -ENODEV;
+ }
+ o->core.dev = get_device(&pdev->dev);
+ o->core.sq2_platform = o;
+ o->start = r->start;
+ o->size = resource_size(r);
+ o->core.irq = platform_get_irq(pdev, 0);
+ if (o->core.irq < 0) { ret = o->core.irq; goto fail; }
+ if (!request_mem_region(o->start, o->size, "sq2-venus-owner")) {
+  ret = -EBUSY;
+  goto fail;
+ }
+ o->region = true;
+ o->core.base = ioremap(o->start, o->size);
+ if (!o->core.base) { ret = -ENOMEM; goto fail; }
+ /* No handler may run before callers have initialized locks and HFI. */
+ ret = request_threaded_irq(o->core.irq, hfi_isr, hfi_isr_thread,
+                            IRQF_TRIGGER_HIGH | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+                            "sq2-venus-owner", &o->core);
+ if (ret)
+  goto fail;
+ o->irq_requested = true;
+ *out = o;
+ return 0;
+fail:
+ if (o->core.base) iounmap(o->core.base);
+ if (o->region) release_mem_region(o->start, o->size);
+ put_device(o->core.dev);
+ kfree(o);
+ module_put(THIS_MODULE);
+ return ret;
+}
+
+int sq2_venus_platform_irq(struct sq2_venus_platform *o, bool enable)
+{
+ if (!o || !o->irq_requested)
+  return -EINVAL;
+ if (enable && (o->lifetime.quarantined || !o->core.priv))
+  return -EBUSY;
+ if (enable == o->irq_enabled)
+  return 0;
+ if (enable) enable_irq(o->core.irq);
+ else disable_irq(o->core.irq); /* synchronizes the threaded handler too */
+ o->irq_enabled = enable;
+ return 0;
+}
+
+int sq2_venus_platform_secure_begin(struct sq2_venus_platform *o)
+{
+ if (!o || !sq2_venus_power_ready(o->power)) return -ENODEV;
+ return o ? sq2_venus_lifetime_begin(&o->lifetime) : -EINVAL;
+}
+
+int sq2_venus_platform_power_on(struct sq2_venus_platform *o)
+{
+ if (!o || !sq2_venus_lifetime_releasable(&o->lifetime)) return -EBUSY;
+ return sq2_venus_power_on(o->core.dev, o->core.base, &o->power);
+}
+
+int sq2_venus_platform_power_off(struct sq2_venus_platform *o)
+{
+ if (!o || !sq2_venus_lifetime_releasable(&o->lifetime) || o->core.sq2_fw_owner)
+  return -EBUSY;
+ sq2_venus_platform_irq(o, false);
+ return sq2_venus_power_off(&o->power, o->core.sq2_boot_attempted);
+}
+
+int sq2_venus_platform_secure_end(struct sq2_venus_platform *o, int pas_status)
+{
+ int ret;
+ if (!o) return -EINVAL;
+ ret = sq2_venus_lifetime_end(&o->lifetime, pas_status);
+ if (o->lifetime.quarantined) {
+  sq2_venus_platform_irq(o, false);
+  dev_err(o->core.dev, "SQ2 PAS stop=%d: core/MMIO/IRQ/device/module retained until reboot\n", ret);
+ }
+ return ret;
+}
+
+int sq2_venus_platform_release(struct sq2_venus_platform **owner)
+{
+ struct sq2_venus_platform *o;
+ if (!owner) return -EINVAL;
+ o = *owner;
+ if (!o) return 0;
+ if (!sq2_venus_lifetime_releasable(&o->lifetime) ||
+     o->core.priv || o->core.sq2_fw_owner || o->power)
+  return -EBUSY;
+ sq2_venus_platform_irq(o, false);
+ free_irq(o->core.irq, &o->core);
+ iounmap(o->core.base);
+ release_mem_region(o->start, o->size);
+ put_device(o->core.dev);
+ *owner = NULL;
+ kfree(o);
+ module_put(THIS_MODULE);
+ return 0;
+}
+
+#ifdef SQ2_VENUS_SYSTEM_PM
+int sq2_venus_platform_system_quiet(struct sq2_venus_platform *o)
+{
+ if (!o || !sq2_venus_lifetime_releasable(&o->lifetime) ||
+     o->core.sq2_fw_owner || o->core.sq2_secure_active) return -EBUSY;
+ return sq2_venus_power_system_quiet(o->power);
+}
+int sq2_venus_platform_system_restore(struct sq2_venus_platform *o)
+{
+ if (!o || !sq2_venus_lifetime_releasable(&o->lifetime) ||
+     o->core.sq2_fw_owner || o->core.sq2_secure_active) return -EBUSY;
+ return sq2_venus_power_system_restore(o->power);
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-platform.h b/drivers/media/platform/qcom/venus/sq2-venus-platform.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-platform.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-platform.h	2026-11-20 21:12:16.434786931 +0100
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_VENUS_PLATFORM_H
+#define SQ2_VENUS_PLATFORM_H
+struct platform_device;
+struct venus_core;
+struct sq2_venus_platform;
+/* Explicit ownership, never devm. Caller serializes transitions. IRQ starts
+ * disabled, and may only be enabled after core/HFI initialization and power-on.
+ */
+int sq2_venus_platform_alloc(struct platform_device *pdev,
+                            struct sq2_venus_platform **out);
+struct venus_core *sq2_venus_platform_core(struct sq2_venus_platform *owner);
+int sq2_venus_platform_irq(struct sq2_venus_platform *owner, bool enable);
+int sq2_venus_platform_secure_begin(struct sq2_venus_platform *owner);
+int sq2_venus_platform_power_on(struct sq2_venus_platform *owner);
+int sq2_venus_platform_power_off(struct sq2_venus_platform *owner);
+int sq2_venus_platform_secure_end(struct sq2_venus_platform *owner, int pas_status);
+/* Release requires confirmed PAS stop AND prior HFI/firmware cleanup.
+ * Power/reset/ICC owner must also be released before this final operation.
+ */
+int sq2_venus_platform_release(struct sq2_venus_platform **owner);
+#ifdef SQ2_VENUS_SYSTEM_PM
+int sq2_venus_platform_system_quiet(struct sq2_venus_platform *owner);
+int sq2_venus_platform_system_restore(struct sq2_venus_platform *owner);
+#endif
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-power.c b/drivers/media/platform/qcom/venus/sq2-venus-power.c
--- a/drivers/media/platform/qcom/venus/sq2-venus-power.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-power.c	2026-11-20 21:12:16.131382476 +0100
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit power owner, ported from the verified private Iris1 sequence.
+ * No devm and no firmware calls. Caller must prove PAS stopped before off.
+ */
+#ifndef SQ2_VENUS_POWER_HOST_TEST
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/clk.h>
+#include <linux/reset.h>
+#include <linux/delay.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+#include <linux/interconnect.h>
+#include <linux/io.h>
+#endif
+#include "sq2-venus-power.h"
+struct sq2_venus_power {
+ struct device *dev, *pd[3];
+ struct clk *clk[7];
+ struct reset_control *rst[4];
+ struct icc_bulk_data icc[3];
+ int npd, nclk, nrst, powered, enabled, states[4];
+ bool voted, resets_changed, rate_changed, config_saved, ready;
+#ifdef SQ2_VENUS_SYSTEM_PM
+ bool system_quiet;
+#endif
+ unsigned long rate;
+ void __iomem *base;
+ u32 cgc, config, version;
+};
+static const char * const clocks[] = {"axic", "axi0", "axi1", "ahb", "core", "vcodec", "cvp"};
+static const char * const resets[] = {"axi", "core", "axi0", "axi1"};
+#ifndef SQ2_VENUS_POWER_HOST_TEST
+static int reset_status(struct device *dev, int index, struct reset_control *rst)
+{
+ static const u32 ids[] = {41, 0, 42, 43};
+ static const u32 regs[] = {0xb02c, 0x850, 0xb024, 0xb028};
+ struct of_phandle_args args;
+ struct platform_device *provider;
+ struct regmap *map;
+ struct resource res;
+ unsigned int value;
+ int ret = reset_control_status(rst);
+ if (ret != -ENOTSUPP)
+  return ret;
+ ret = of_parse_phandle_with_args(dev->of_node, "resets", "#reset-cells", index, &args);
+ if (ret)
+  return ret;
+ if (args.args_count != 1 || args.args[0] != ids[index] ||
+     !of_device_is_compatible(args.np, index == 1 ? "qcom,sm8150-videocc" : "qcom,gcc-sc8180x") ||
+     of_address_to_resource(args.np, 0, &res) ||
+     res.start != (index == 1 ? 0xab00000 : 0x100000) ||
+     resource_size(&res) < regs[index] + 4) {
+  of_node_put(args.np);
+  return -EINVAL;
+ }
+ provider = of_find_device_by_node(args.np);
+ of_node_put(args.np);
+ if (!provider)
+  return -EPROBE_DEFER;
+ map = dev_get_regmap(&provider->dev, NULL);
+ if (!provider->dev.driver || !map)
+  ret = -ENODEV;
+ else {
+  ret = regmap_read(map, regs[index], &value);
+  if (!ret) {
+   pr_info("SQ2_IRIS1_IDENTIFY phase=reset_status_regmap index=%d reg=%x raw=%08x\n",
+           index, regs[index], value);
+   ret = !!(value & BIT(2));
+  }
+ }
+ put_device(&provider->dev);
+ return ret;
+}
+
+#endif
+static int pulse(struct sq2_venus_power *p)
+{
+ int i, ret;
+ for (i=0;i<4;i++) {
+  ret=reset_control_assert(p->rst[i]);
+  if(ret) return ret;
+ }
+ usleep_range(150,250);
+ for(i=0;i<4;i++) {
+  ret=reset_control_deassert(p->rst[i]);
+  if(ret) return ret;
+ }
+ return 0;
+}
+bool sq2_venus_power_ready(struct sq2_venus_power *p)
+{
+ return p && p->ready;
+}
+int sq2_venus_power_on(struct device *dev, void __iomem *base, struct sq2_venus_power **out)
+{
+ struct sq2_venus_power *p;
+ int i,ret;
+ if (!out || *out || !base) return -EINVAL;
+ p=kzalloc(sizeof(*p),GFP_KERNEL);
+ if(!p) return -ENOMEM;
+ *out=p; p->dev=dev; p->base=base;
+ p->icc[0]=(struct icc_bulk_data){.name="cpu-cfg",.avg_bw=1000,.peak_bw=1000};
+ p->icc[1]=(struct icc_bulk_data){.name="video-mem",.peak_bw=304000};
+ p->icc[2]=(struct icc_bulk_data){.name="firmware-mem",.peak_bw=304000};
+ ret=of_icc_bulk_get(dev,3,p->icc);
+ if(ret) return ret;
+ p->voted=true;
+ for(i=0;i<3;i++) if(!p->icc[i].path) return -ENODEV;
+ ret=icc_bulk_set_bw(3,p->icc);
+ if(ret) return ret;
+ for(i=0;i<3;i++) {
+  p->pd[i]=dev_pm_domain_attach_by_id(dev,i);
+  if(IS_ERR_OR_NULL(p->pd[i])) return p->pd[i] ? PTR_ERR(p->pd[i]) : -ENODEV;
+  p->npd++;
+ }
+ for(i=0;i<7;i++) {
+  p->clk[i]=clk_get(dev,clocks[i]);
+  if(IS_ERR(p->clk[i])) return PTR_ERR(p->clk[i]);
+  p->nclk++;
+ }
+ for(i=0;i<4;i++) {
+  p->rst[i]=reset_control_get_exclusive(dev,resets[i]);
+  if(IS_ERR(p->rst[i])) return PTR_ERR(p->rst[i]);
+  p->nrst++;
+  ret=reset_status(dev,i,p->rst[i]);
+  if(ret<0) return ret;
+  p->states[i]=ret;
+ }
+ for(i=0;i<3;i++) {
+  ret=pm_runtime_resume_and_get(p->pd[i]);
+  if(ret<0) return ret;
+  p->powered++;
+ }
+ p->resets_changed=true;
+ ret=pulse(p);
+ if(ret) return ret;
+ for(i=0;i<7;i++) {
+  ret=clk_prepare_enable(p->clk[i]);
+  if(ret) return ret;
+  p->enabled++;
+ }
+ p->rate=clk_get_rate(p->clk[4]);
+ p->rate_changed=true;
+ ret=clk_set_rate(p->clk[4],200000000);
+ if(ret) return ret;
+ if(clk_get_rate(p->clk[4])<199999000 || clk_get_rate(p->clk[4])>200001000) return -ERANGE;
+ p->version=readl(base+0xe0000);
+ if(p->version!=0x5010002f) return -ENODEV;
+ p->cgc=readl(base+0xe2010); p->config=readl(base+0xe2000);
+ p->config_saved=true;
+ p->ready=true;
+ return 0;
+}
+int sq2_venus_power_off(struct sq2_venus_power **owner, bool firmware_attempted)
+{
+ struct sq2_venus_power *p;
+ int i,ret,first=0;
+ if(!owner) return -EINVAL;
+ p=*owner;
+ if(!p) return 0;
+ p->ready=false;
+ if(p->config_saved) {
+  writel(p->config,p->base+0xe2000); writel(p->cgc,p->base+0xe2010);
+  p->config_saved=false;
+ }
+ if(p->rate_changed) {
+  ret=clk_set_rate(p->clk[4],p->rate);
+  if(ret) return ret; /* keep powered references; do not free partial state */
+  p->rate_changed=false;
+ }
+ while(p->enabled) clk_disable_unprepare(p->clk[--p->enabled]);
+ if(firmware_attempted && p->resets_changed && (p->version & ~0xffffU)==0x50100000) {
+  ret=pulse(p);
+  if(ret) return ret;
+ }
+ if(p->resets_changed) {
+  for(i=0;i<4;i++) {
+   ret=p->states[i] ? reset_control_assert(p->rst[i]) : reset_control_deassert(p->rst[i]);
+   if(ret) return ret;
+  }
+  p->resets_changed=false;
+ }
+ while(p->powered) {
+  ret=pm_runtime_put_sync(p->pd[--p->powered]);
+  if(ret<0 && !first) first=ret;
+ }
+ while(p->nclk) clk_put(p->clk[--p->nclk]);
+ while(p->nrst) reset_control_put(p->rst[--p->nrst]);
+ while(p->npd) dev_pm_domain_detach(p->pd[--p->npd],false);
+ if(p->voted) {
+  for(i=2;i>=0;i--) {
+   ret=icc_set_bw(p->icc[i].path,0,0);
+   if(ret && !first) first=ret;
+  }
+  icc_bulk_put(3,p->icc);
+ }
+ kfree(p); *owner=NULL;
+ return first;
+}
+
+#ifdef SQ2_VENUS_SYSTEM_PM
+/* The genpd virtual devices/usage references stay owned. System noirq PM owns
+ * domain transitions; detaching/reattaching devices during the PM walk is not
+ * permitted here. Caller has already proven firmware/DMA stopped. */
+int sq2_venus_power_system_quiet(struct sq2_venus_power *p)
+{
+ int i, ret;
+ if (!p || p->powered != 3 || p->npd != 3 || p->nclk != 7 ||
+     p->nrst != 4 || !p->voted) return -EINVAL;
+ if (p->system_quiet) return 0;
+ p->ready = false;
+ if (p->config_saved) {
+  writel(p->config, p->base + 0xe2000);
+  writel(p->cgc, p->base + 0xe2010);
+  p->config_saved = false;
+ }
+ if (p->rate_changed) {
+  ret = clk_set_rate(p->clk[4], p->rate);
+  if (ret) return ret;
+  p->rate_changed = false;
+ }
+ while (p->enabled) clk_disable_unprepare(p->clk[--p->enabled]);
+ for (i = 2; i >= 0; i--) {
+  ret = icc_set_bw(p->icc[i].path, 0, 0);
+  if (ret) return ret;
+ }
+ p->system_quiet = true;
+ return 0;
+}
+int sq2_venus_power_system_restore(struct sq2_venus_power *p)
+{
+ int i, ret;
+ if (!p || !p->system_quiet || p->enabled || p->powered != 3 ||
+     p->npd != 3 || p->nclk != 7 || p->nrst != 4) return -EINVAL;
+ p->system_quiet = false;
+ ret = icc_bulk_set_bw(3, p->icc);
+ if (ret) return ret;
+ ret = pulse(p);
+ if (ret) return ret;
+ for (i = 0; i < 7; i++) {
+  ret = clk_prepare_enable(p->clk[i]);
+  if (ret) return ret;
+  p->enabled++;
+ }
+ p->rate = clk_get_rate(p->clk[4]);
+ p->rate_changed = true;
+ ret = clk_set_rate(p->clk[4], 200000000);
+ if (ret) return ret;
+ if (clk_get_rate(p->clk[4]) < 199999000 ||
+     clk_get_rate(p->clk[4]) > 200001000) return -ERANGE;
+ p->version = readl(p->base + 0xe0000);
+ if (p->version != 0x5010002f) return -ENODEV;
+ p->cgc = readl(p->base + 0xe2010);
+ p->config = readl(p->base + 0xe2000);
+ p->config_saved = true;
+ p->ready = true;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-power.h b/drivers/media/platform/qcom/venus/sq2-venus-power.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-power.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-power.h	2026-11-20 21:12:16.443111939 +0100
