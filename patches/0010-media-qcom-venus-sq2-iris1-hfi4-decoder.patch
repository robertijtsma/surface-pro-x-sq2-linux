diff -ruN a/drivers/media/platform/qcom/venus/sq2-fw-transaction.h b/drivers/media/platform/qcom/venus/sq2-fw-transaction.h
--- a/drivers/media/platform/qcom/venus/sq2-fw-transaction.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-fw-transaction.h	2026-11-20 21:12:16.361034049 +0100
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_FW_TRANSACTION_H
+#define SQ2_FW_TRANSACTION_H
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+/* The caller serializes operations. alloc must undo partial allocation on error.
+ * release must not destroy this transaction object. No automatic quarantine
+ * retry: an unconfirmed PAS shutdown requires a board reboot.
+ */
+enum sq2_fw_state { SQ2_FW_EMPTY, SQ2_FW_OWNED, SQ2_FW_TOUCHED,
+                    SQ2_FW_LIVE, SQ2_FW_QUARANTINED };
+struct sq2_fw_transaction {
+ enum sq2_fw_state state;
+ int stop_error;
+};
+struct sq2_fw_operations {
+ int (*alloc)(void *);
+ int (*load)(void *);
+ int (*start)(void *);
+ int (*stop)(void *);
+ void (*release)(void *);
+};
+static int sq2_fw_stop(struct sq2_fw_transaction *t,
+                       const struct sq2_fw_operations *ops, void *ctx)
+{
+ int ret;
+ if (t->state == SQ2_FW_EMPTY)
+  return 0;
+ if (t->state == SQ2_FW_QUARANTINED)
+  return t->stop_error;
+ if (t->state != SQ2_FW_OWNED) {
+  ret = ops->stop(ctx);
+  if (ret) {
+   t->stop_error = ret;
+   t->state = SQ2_FW_QUARANTINED;
+   return ret;
+  }
+ }
+ ops->release(ctx);
+ t->state = SQ2_FW_EMPTY;
+ return 0;
+}
+static int sq2_fw_start(struct sq2_fw_transaction *t,
+                        const struct sq2_fw_operations *ops, void *ctx)
+{
+ int ret;
+ if (t->state != SQ2_FW_EMPTY)
+  return -EBUSY;
+ ret = ops->alloc(ctx);
+ if (ret)
+  return ret;
+ t->state = SQ2_FW_OWNED;
+ /* Even failed load may have handed metadata/memory to secure world. */
+ t->state = SQ2_FW_TOUCHED;
+ ret = ops->load(ctx);
+ if (!ret)
+  ret = ops->start(ctx);
+ if (ret) {
+  sq2_fw_stop(t, ops, ctx);
+  return ret;
+ }
+ t->state = SQ2_FW_LIVE;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-hfi-properties.h b/drivers/media/platform/qcom/venus/sq2-hfi-properties.h
--- a/drivers/media/platform/qcom/venus/sq2-hfi-properties.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-hfi-properties.h	2026-11-20 21:12:16.371871217 +0100
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_HFI_PROPERTIES_H
+#define SQ2_HFI_PROPERTIES_H
+/* Host/kernel shared walker for the observed Iris1 SYS_INIT body. u32 must be
+ * supplied by the caller. Callback payloads are bounded; consumers must also
+ * bound their destination arrays and publish only after the whole walk passes.
+ */
+typedef int (*sq2_hfi_property_fn)(void *, u32, const u32 *, u32);
+static inline int sq2_hfi_properties(const u32 *body, u32 words,
+                                    sq2_hfi_property_fn visit, void *context,
+                                    u32 *records)
+{
+ u32 at=0, count=0;
+ if(!body||!words||words>4096||!records)return -1;
+ while(at<words){
+  u32 id=body[at++], start=at, n, i, planes;
+  switch(id){
+  case 0x1009: case 0x100e:
+   if(words-at<2)return -1;
+   at+=2;break;
+  case 0x1010: case 0x100a:
+   if(words-at<1)return -1;
+   at++;break;
+  case 0x1016:
+   /* Observed trailing TME version: do not infer a variable-size layout. */
+   if(words-at!=1)return -1;
+   at++;break;
+  case 0x1007: case 0x1006:
+   if(words-at<1)return -1;
+   n=body[at++];i=id==0x1007?4:2;
+   if(n>(words-at)/i)return -1;
+   at+=n*i;break;
+  case 0x20100b:
+   if(words-at<2)return -1;
+   n=body[at+1];at+=2;
+   if(n>words-at)return -1;
+   at+=n;break;
+  case 0x1004:
+   if(words-at<2)return -1;
+   n=body[at+1];at+=2;
+   if(n>(words-at)/2)return -1;
+   for(i=0;i<n;i++){
+    if(words-at<2)return -1;
+    planes=body[at+1];at+=2;
+    if(!planes||planes>4||planes>(words-at)/4)return -1;
+    at+=planes*4;
+   }
+   break;
+  default:return -1;
+  }
+  if(visit&&visit(context,id,body+start,at-start))return -1;
+  count++;
+ }
+ *records=count;return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2_pil_mem_query.c b/drivers/media/platform/qcom/venus/sq2_pil_mem_query.c
--- a/drivers/media/platform/qcom/venus/sq2_pil_mem_query.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2_pil_mem_query.c	2026-11-20 21:12:16.093612110 +0100
@@ -0,0 +1,86 @@
+#include <linux/platform_device.h>
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only TZ_PIL_GET_MEM_AREA (PIL cmd9, spare0, arginfo1).
+ * Linux 6.3 has no exported wrapper. Resolve only the pinned private SCM call
+ * entry, then unregister the address lookup probe before invoking it normally.
+ * The SCM driver performs convention selection, locking, waitq and retries.
+ * No load, memory assignment, authentication, register write or firmware start.
+ */
+#include <linux/module.h>
+#include <linux/kprobes.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/arm-smccc.h>
+#include "qcom_scm.h"
+#include "sq2-pil-region.h"
+#ifndef SQ2_PIL_QUERY_LIBRARY
+static bool allow;
+module_param(allow, bool, 0400);
+#endif
+int sq2_pil_get_bounds(phys_addr_t *start, phys_addr_t *end)
+{
+ struct device_node *node;
+ struct platform_device *pdev;
+ struct kprobe lookup = { .symbol_name = "qcom_scm_call" };
+ int (*call)(struct device *, const struct qcom_scm_desc *, struct qcom_scm_res *);
+ struct qcom_scm_desc desc = {
+  .svc = QCOM_SCM_SVC_PIL, .cmd = 9, .arginfo = QCOM_SCM_ARGS(1),
+  .args = {0}, .owner = ARM_SMCCC_OWNER_SIP,
+ };
+ struct qcom_scm_res result = {0};
+ int ret;
+ if (!of_machine_is_compatible("microsoft,surface-pro-x"))
+  return -EPERM;
+ if (!qcom_scm_is_available())
+  return -EPROBE_DEFER;
+ node = of_find_node_by_path("/firmware/scm");
+ if (!node)
+  return -ENODEV;
+ if (!of_device_is_compatible(node, "qcom,scm-sc8180x")) {
+  of_node_put(node);
+  return -EINVAL;
+ }
+ pdev = of_find_device_by_node(node);
+ of_node_put(node);
+ if (!pdev)
+  return -ENODEV;
+ if (!pdev->dev.driver) {
+  ret = -ENODEV;
+  goto put;
+ }
+ ret = register_kprobe(&lookup);
+ if (ret)
+  goto put;
+ call = (void *)lookup.addr;
+ unregister_kprobe(&lookup);
+ pr_info("SQ2_PIL_MEM_QUERY begin cmd=9 spare=0 READ_ONLY\n");
+ ret = call(&pdev->dev, &desc, &result);
+ pr_info("SQ2_PIL_MEM_QUERY end ret=%d result=%llx,%llx,%llx; not an ownership grant\n",
+         ret, result.result[0], result.result[1], result.result[2]);
+ if (!ret) {
+  if (!result.result[0] || result.result[1] <= result.result[0] ||
+      result.result[1] > (1ULL << 32))
+   ret = -ERANGE;
+  else {
+   *start = result.result[0];
+   *end = result.result[1];
+  }
+ }
+put:
+ put_device(&pdev->dev);
+ return ret;
+}
+#ifndef SQ2_PIL_QUERY_LIBRARY
+static int __init query(void)
+{
+ phys_addr_t start, end;
+ if (!allow) return -EPERM;
+ return sq2_pil_get_bounds(&start, &end);
+}
+static void __exit done(void) { }
+module_init(query);
+module_exit(done);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Read-only documented PIL load-region query for SQ2 lab");
+#endif
