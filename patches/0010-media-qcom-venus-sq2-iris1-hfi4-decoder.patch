diff -ruN a/drivers/media/platform/qcom/venus/venus-iris1.h b/drivers/media/platform/qcom/venus/venus-iris1.h
--- a/drivers/media/platform/qcom/venus/venus-iris1.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-iris1.h	2026-11-20 21:12:16.489895891 +0100
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Iris1/VPU5 register differences, using HFI 4xx messages.
+ * Reference: OnePlus SM8150 32f26bf3, venus_hfi.c/vidc_hfi_io.h.
+ * core.h and hfi_venus_io.h must precede this header.
+ */
+#ifndef SQ2_VENUS_IRIS1_H
+#define SQ2_VENUS_IRIS1_H
+
+/* Explicit SQ2 Windows-reference profile; never implied by HFI4 alone. */
+#define SQ2_VENUS_UC_BYTES 0x01000000U
+static inline int venus_sq2_uc_valid(unsigned long long addr, u32 size)
+{
+ return size == SQ2_VENUS_UC_BYTES && addr >= 0x25800000ULL &&
+        addr <= 0xc0000000ULL - size;
+}
+
+static inline void venus_sq2_cpu_map(struct venus_core *core, u32 addr,
+                                    u32 sfr)
+{
+ writel(addr, core->cpu_cs_base + 0x64);
+ writel(SQ2_VENUS_UC_BYTES, core->cpu_cs_base + 0x68);
+ writel(addr, core->cpu_cs_base + 0x54);
+ writel(1, core->cpu_cs_base + 0x50);
+ writel(sfr, core->cpu_cs_base + 0x5c);
+ writel(0, core->cpu_cs_base + 0x60);
+}
+
+static inline void venus_iris1_clock_config(struct venus_core *core)
+{
+ writel(0, core->wrapper_base + WRAPPER_CPU_CGC_DIS);
+ writel(0, core->wrapper_base + WRAPPER_CPU_CLOCK_CONFIG);
+}
+
+static inline void venus_iris1_dsp_map(struct venus_core *core, u32 addr, u32 size)
+{
+ /* No CVP domain: the downstream VPU5 path mirrors the CPU interface queues. */
+ writel(addr, core->cpu_cs_base + 0x34); /* VMIMSG: DSP QTBL */
+ writel(addr, core->cpu_cs_base + 0x38); /* VMIMSGAG0: DSP UC address */
+ writel(size, core->cpu_cs_base + 0x3c); /* VMIMSGAG1: DSP UC size */
+}
+
+static inline u32 venus_iris1_irq_mask(u32 mask)
+{
+ return mask & ~(WRAPPER_INTR_MASK_A2HWD_BASK | WRAPPER_INTR_MASK_A2HCPU_MASK);
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-avc-export.h b/drivers/media/platform/qcom/venus/venus-sq2-avc-export.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-avc-export.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-avc-export.h	2026-11-20 21:12:16.497405389 +0100
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Bounded read-only copies of the actual firmware decoder tables. */
+static int sq2_avc_caps_get(char *buf, const struct kernel_param *kp)
+{
+ struct venus_core *core = READ_ONCE(sq2_pm_status_core);
+ const struct hfi_plat_caps *c;
+ unsigned int i;
+ int n = 0;
+ u32 codec = kp->arg ? *(const u32 *)kp->arg : HFI_VIDEO_CODEC_H264;
+ if (!core) return -ENODATA;
+ mutex_lock(&core->pm_lock);
+ mutex_lock(&core->lock);
+ if (core->state != CORE_INIT || test_bit(0, &core->sys_error)) { n = -EIO; goto done; }
+ c = venus_caps_by_codec(core, codec, VIDC_SESSION_TYPE_DEC);
+ if (!c || !c->num_pl || !c->num_caps) { n = -ENODATA; goto done; }
+ #define EMIT(...) do { int k = snprintf(buf+n, PAGE_SIZE-n, __VA_ARGS__); \
+  if (k < 0 || k >= PAGE_SIZE-n) { n = -EOVERFLOW; goto done; } n += k; } while (0)
+ EMIT("version=1\nsessions=%u\n", core->max_sessions_supported);
+ for (i=0; i<c->num_caps; i++)
+  EMIT("cap=%u,%u,%u,%u\n", c->caps[i].capability_type,c->caps[i].min,c->caps[i].max,c->caps[i].step_size);
+ for (i=0; i<c->num_pl; i++) EMIT("pl=%u,%u\n",c->pl[i].profile,c->pl[i].level);
+ for (i=0; i<c->num_fmts; i++) EMIT("fmt=%u,%u\n",c->fmts[i].buftype,c->fmts[i].fmt);
+ EMIT("end=1\n");
+ #undef EMIT
+done:
+ mutex_unlock(&core->lock);
+ mutex_unlock(&core->pm_lock);
+ return n;
+}
+static const struct kernel_param_ops sq2_avc_caps_ops = {.get=sq2_avc_caps_get};
+module_param_cb(sq2_avc_caps, &sq2_avc_caps_ops, NULL, 0444);
+
+/* Keep the original AVC ABI while exposing each codec independently. */
+#define SQ2_CAPS_PARAM(name, codec) \
+ static const u32 name##_codec = codec; \
+ module_param_cb(name, &sq2_avc_caps_ops, (void *)&name##_codec, 0444)
+SQ2_CAPS_PARAM(sq2_hevc_caps, HFI_VIDEO_CODEC_HEVC);
+SQ2_CAPS_PARAM(sq2_vp8_caps, HFI_VIDEO_CODEC_VP8);
+SQ2_CAPS_PARAM(sq2_vp9_caps, HFI_VIDEO_CODEC_VP9);
+SQ2_CAPS_PARAM(sq2_mpeg2_caps, HFI_VIDEO_CODEC_MPEG2);
+SQ2_CAPS_PARAM(sq2_mpeg1_caps, HFI_VIDEO_CODEC_MPEG1);
+#undef SQ2_CAPS_PARAM
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-callback.h b/drivers/media/platform/qcom/venus/venus-sq2-callback.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-callback.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-callback.h	2026-11-20 21:12:16.503775871 +0100
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_CALLBACK_H
+#define VENUS_SQ2_CALLBACK_H
+#ifndef SQ2_CALLBACK_HOST_TEST
+#include "hfi_msgs.h"
+#endif
+/* Called under core->lock, while the instance is still on core->instances. */
+static inline bool sq2_callback_get(struct venus_inst *inst, u32 packet)
+{
+ if (!IS_SQ2_HFI(inst->core)) return true;
+ if (inst->sq2_closing &&
+     (packet == HFI_MSG_SESSION_EMPTY_BUFFER ||
+      packet == HFI_MSG_SESSION_FILL_BUFFER || packet == HFI_MSG_EVENT_NOTIFY))
+  return false;
+ atomic_inc(&inst->sq2_callbacks);
+ return true;
+}
+
+static inline void sq2_callback_put(struct venus_inst *inst)
+{
+ struct venus_core *core;
+ if (!inst || !IS_SQ2_HFI(inst->core)) return;
+ core = inst->core;
+ /* Cache core before dropping the last instance reference. A waiter can free
+  * inst immediately at zero; never use an instance-owned waitqueue here. */
+ if (atomic_dec_and_test(&inst->sq2_callbacks))
+  wake_up_all(&core->sys_err_done);
+}
+
+static inline void sq2_callback_drain(struct venus_inst *inst)
+{
+ if (IS_SQ2_HFI(inst->core))
+  wait_event(inst->core->sys_err_done, !atomic_read(&inst->sq2_callbacks));
+}
+
+static inline void sq2_callback_close_begin(struct venus_inst *inst)
+{
+ struct venus_core *core = inst->core;
+ if (!IS_SQ2_HFI(core)) return;
+ mutex_lock(&core->lock);
+ WRITE_ONCE(inst->sq2_closing, true);
+ mutex_unlock(&core->lock);
+ /* No core/instance lock held while IRQ callbacks finish. Control replies
+  * remain enabled so STOP/FLUSH/RELEASE waits during VB2 teardown can finish. */
+ sq2_callback_drain(inst);
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-capabilities.h b/drivers/media/platform/qcom/venus/venus-sq2-capabilities.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-capabilities.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-capabilities.h	2026-11-20 21:12:16.509508247 +0100
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_CAPABILITIES_H
+#define VENUS_SQ2_CAPABILITIES_H
+#include <linux/slab.h>
+#include "sq2-hfi-properties.h"
+/* Included after core.h/hfi_helper.h. No changes to other Venus platforms. */
+struct sq2_caps_transaction {
+ struct hfi_plat_caps caps[MAX_CODEC_NUM];
+ u32 count, dec, enc, sessions, codecs, domains;
+ bool declared;
+};
+static int sq2_caps_property(void *context,u32 id,const u32 *p,u32 words)
+{
+ struct sq2_caps_transaction *t=context;
+ u32 i,j,n,at;
+ (void)words; /* Walker has validated every source span. */
+ if(id==0x1009){
+  if(t->declared||!p[0])return -1;
+  t->declared=true;t->dec=p[0];t->enc=p[1];
+  for(i=1;i<=2;i++)for(j=0;j<32;j++){
+   u32 bit=1U<<j,mask=i==1?t->enc:t->dec;
+   struct hfi_plat_caps *c;
+   if(!(mask&bit))continue;
+   if(t->count>=MAX_CODEC_NUM)return -1;
+   c=&t->caps[t->count++];c->codec=bit;c->domain=i;
+  }
+  return 0;
+ }
+ if(id==0x1010){if(!p[0]||p[0]>MAX_SESSIONS)return -1;t->sessions=p[0];return 0;}
+ if(id==0x100a||id==0x1016)return 0;
+ if(!t->declared)return -1;
+ if(id==0x100e){
+  if(!p[0]||!p[1]||(p[1]&~3U)|| (p[0]&~(t->dec|t->enc)))return -1;
+  t->codecs=p[0];t->domains=p[1];return 0;
+ }
+ if(!t->codecs||!t->domains)return -1;
+ for(i=0;i<t->count;i++){
+  struct hfi_plat_caps *c=&t->caps[i];
+  if(!(c->codec&t->codecs)||!(c->domain&t->domains))continue;
+  switch(id){
+  case 0x1007:
+   n=p[0];if(n>MAX_CAP_ENTRIES-c->num_caps)return -1;
+   for(j=0;j<n;j++){
+    const u32 *v=p+1+j*4;
+    if(v[1]>v[2]||!v[3])return -1;
+   }
+   memcpy(c->caps+c->num_caps,p+1,n*sizeof(c->caps[0]));c->num_caps+=n;break;
+  case 0x1006:
+   n=p[0];if(n>HFI_MAX_PROFILE_COUNT-c->num_pl)return -1;
+   memcpy(c->pl+c->num_pl,p+1,n*sizeof(c->pl[0]));c->num_pl+=n;break;
+  case 0x1004:
+   n=p[1];if(n>MAX_FMT_ENTRIES-c->num_fmts)return -1;
+   at=2;
+   for(j=0;j<n;j++){
+    c->fmts[c->num_fmts].buftype=p[0];c->fmts[c->num_fmts++].fmt=p[at];
+    at+=2+4*p[at+1];
+   }
+   break;
+  case 0x20100b:
+   if(p[1]>MAX_ALLOC_MODE_ENTRIES)return -1;
+   if(p[0]==HFI_BUFFER_OUTPUT||p[0]==HFI_BUFFER_OUTPUT2)
+    for(j=0;j<p[1];j++)if(p[j+2]==HFI_BUFFER_MODE_DYNAMIC)c->cap_bufs_mode_dynamic=true;
+   break;
+  default:return -1;
+  }
+ }
+ return 0;
+}
+static u32 venus_sq2_parse_capabilities(struct venus_core *core,const void *body,u32 size,u32 expected)
+{
+ struct sq2_caps_transaction *t;
+ u32 records=0,result=HFI_ERR_SYS_INSUFFICIENT_RESOURCES;
+ if(!size||size%4||!expected)return result;
+ t=kzalloc(sizeof(*t),GFP_KERNEL);if(!t)return result;
+ if(sq2_hfi_properties(body,size/4,sq2_caps_property,t,&records)||records!=expected||!t->declared||!t->count)
+  goto done;
+ /* Publish only a complete, validated table. Retain no pointers into packet. */
+ memcpy(core->caps,t->caps,sizeof(t->caps));
+ core->codecs_count=t->count;core->dec_codecs=t->dec;core->enc_codecs=t->enc;
+ core->max_sessions_supported=t->sessions?t->sessions:MAX_SESSIONS;
+ result=HFI_ERR_NONE;
+done:
+ kfree(t);return result;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-capture-layout.h b/drivers/media/platform/qcom/venus/venus-sq2-capture-layout.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-capture-layout.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-capture-layout.h	2026-11-20 21:12:16.515304376 +0100
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_CAPTURE_LAYOUT_H
+#define VENUS_SQ2_CAPTURE_LAYOUT_H
+/* Keep coded dimensions/crop separate from the client's linear allocation.
+ * Constraints describe real firmware output; metadata alone cannot change it.
+ */
+static int sq2_capture_layout(u32 format, u32 width, u32 height,
+                             u32 stride, u32 scan, u32 minimum, u32 *size)
+{
+ u32 bpp;
+ if (format != V4L2_PIX_FMT_NV12 && format != V4L2_PIX_FMT_P010)
+  return -EINVAL;
+ bpp = format == V4L2_PIX_FMT_P010 ? 2 : 1;
+ if (!width || !height || width > 8192 || height > 8192 ||
+     stride < width * bpp || stride > 16384 || stride % 128 ||
+     scan < height || scan > 8192 || scan % 32)
+  return -EINVAL;
+ *size = max(minimum, ALIGN(stride * scan * 3 / 2, 4096));
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-close-guard.h b/drivers/media/platform/qcom/venus/venus-sq2-close-guard.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-close-guard.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-close-guard.h	2026-11-20 21:12:16.522971904 +0100
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_CLOSE_GUARD_H
+#define VENUS_SQ2_CLOSE_GUARD_H
+/* INST_UNINIT is not proof of no firmware session: an INIT reply may time out
+ * after the firmware accepted it. Scope ownership is the authoritative fact. */
+static bool venus_sq2_session_unresolved(struct venus_inst *inst)
+{
+ struct venus_core *core = inst->core;
+ bool unresolved;
+ if (!IS_SQ2_HFI(core)) return false;
+ mutex_lock(&core->sq2_retire_lock);
+ unresolved = inst->sq2_scope && !inst->sq2_scope->ended;
+ mutex_unlock(&core->sq2_retire_lock);
+ return unresolved || (inst->sq2_end_sent && !inst->sq2_end_confirmed);
+}
+
+/* Before an unresolved instance can be unlinked/freed, prohibit new firmware
+ * session IDs (hash32_ptr) from reusing its address. Do not fabricate END, clear
+ * the error, retry PAS, or schedule recovery. DMA stays in existing retirement
+ * until a separately verified complete stop/reboot. Never-init closes are safe. */
+static bool venus_sq2_quarantine_unresolved(struct venus_inst *inst,
+                                           int error, const char *stage)
+{
+ struct venus_core *core = inst->core;
+ if (!venus_sq2_session_unresolved(inst)) return false;
+ mutex_lock(&core->lock);
+ set_bit(0, &core->sys_error);
+ mutex_unlock(&core->lock);
+ inst->session_error = true;
+ dev_err(core->dev, "SQ2 session quarantine stage=%s error=%d; END unconfirmed, admission closed\n",
+         stage, error);
+ return true;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-core.h b/drivers/media/platform/qcom/venus/venus-sq2-core.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-core.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-core.h	2026-11-20 21:12:16.531866264 +0100
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included in core.c after its register-offset and capability helpers.
+ * Experimental, explicit opt-in. No resource match is added by this file.
+ * Published V4L2 cores remain allocated until reboot on remove: open file and
+ * queued buffer lifetime must not be guessed from an instantaneous list count.
+ */
+#ifndef VENUS_SQ2_CORE_H
+#define VENUS_SQ2_CORE_H
+#include "sq2-venus-platform.h"
+#include "sq2-venus-retire.h"
+static bool sq2_platform_allow;
+module_param(sq2_platform_allow, bool, 0600);
+static const struct venus_pm_ops sq2_resident_pm_ops = {0};
+
+static int venus_sq2_stop_core(struct venus_core *core)
+{
+ int ret;
+ sq2_venus_platform_irq(core->sq2_platform, false);
+ mutex_lock(&core->lock);
+ set_bit(0, &core->sys_error);
+ if (core->priv) core->ops->core_deinit(core);
+ core->state = CORE_UNINIT;
+ ret = venus_shutdown(core);
+ mutex_unlock(&core->lock);
+ if (ret) return ret; /* firmware, HFI and powered platform remain owned */
+ sq2_venus_retire_stopped(core);
+ return sq2_venus_platform_power_off(core->sq2_platform);
+}
+
+static void venus_sq2_error(struct work_struct *work)
+{
+ struct venus_core *core = container_of(work, struct venus_core, work.work);
+ int ret = venus_sq2_stop_core(core);
+ dev_err(core->dev, "SQ2 terminal firmware error, stop=%d; no automatic firmware restart\n", ret);
+ /* No stock coredump, hfi_reinit, second PAS start or scheduled retry. */
+}
+
+static int venus_sq2_remove(struct platform_device *pdev)
+{
+ struct venus_core *core = platform_get_drvdata(pdev);
+ int ret;
+ cancel_delayed_work_sync(&core->work);
+ ret = venus_sq2_stop_core(core);
+ if (core->sq2_children) {
+  of_platform_depopulate(core->dev);
+  core->sq2_children = false;
+ }
+ if (core->sq2_pm_enabled) {
+  pm_runtime_disable(core->dev);
+  core->sq2_pm_enabled = false;
+ }
+ /* A published core may still be referenced by open V4L2 files. Keep core,
+  * v4l2_device, HFI queues and module pin even after confirmed PAS stop.
+  * This is bounded lab quarantine, not completed hot-unplug support. */
+ dev_warn(core->dev, "SQ2 removed, stop=%d; published owner retained until reboot\n", ret);
+ return ret;
+}
+
+static int venus_sq2_probe(struct platform_device *pdev,
+                           const struct venus_resources *res)
+{
+ struct sq2_venus_platform *owner = NULL;
+ struct venus_core *core;
+ int ret, stop;
+ if (!sq2_platform_allow) return -EOPNOTSUPP;
+ if (!res->iris1 || res->hfi_version != HFI_VERSION_4XX) return -EINVAL;
+ ret = sq2_venus_platform_alloc(pdev, &owner);
+ if (ret) return ret;
+ core = sq2_venus_platform_core(owner);
+ core->res = res;
+ core->use_tz = true;
+ core->pm_ops = &sq2_resident_pm_ops;
+ mutex_init(&core->lock);
+ mutex_init(&core->pm_lock);
+ sq2_venus_retire_init(core);
+ INIT_LIST_HEAD(&core->instances);
+ INIT_DELAYED_WORK(&core->work, venus_sq2_error);
+ init_waitqueue_head(&core->sys_err_done);
+ platform_set_drvdata(pdev, core);
+ venus_assign_register_offsets(core);
+ ret = sq2_venus_platform_power_on(owner);
+ if (ret) goto fail;
+ ret = hfi_create(core, &venus_core_ops);
+ if (ret) goto fail;
+ ret = venus_boot(core);
+ if (ret) goto fail;
+ ret = hfi_core_resume(core, true);
+ if (ret) goto fail;
+ ret = sq2_venus_platform_irq(owner, true);
+ if (ret) goto fail;
+ ret = hfi_core_init(core);
+ if (ret) goto fail;
+ ret = venus_enumerate_codecs(core, VIDC_SESSION_TYPE_DEC);
+ if (ret) goto fail;
+ ret = v4l2_device_register(core->dev, &core->v4l2_dev);
+ if (ret) goto fail;
+ core->sq2_public = true;
+ /* Keep firmware/power resident. Child PM callbacks are intentionally empty
+  * while the real parent owner holds all seven clocks and three domains. */
+ ret = pm_runtime_set_active(core->dev);
+ if (ret) goto fail;
+ pm_runtime_enable(core->dev);
+ core->sq2_pm_enabled = true;
+ core->sq2_children = true; /* also depopulate partial population on error */
+ ret = of_platform_populate(core->dev->of_node, NULL, NULL, core->dev);
+ if (ret) goto fail;
+ venus_sq2_pm_publish(core);
+ return 0;
+fail:
+ cancel_delayed_work_sync(&core->work);
+ stop = venus_sq2_stop_core(core);
+ if (stop || core->sq2_public) {
+  if (core->sq2_children) {
+   of_platform_depopulate(core->dev);
+   core->sq2_children = false;
+  }
+  if (core->sq2_pm_enabled) {
+   pm_runtime_disable(core->dev);
+   core->sq2_pm_enabled = false;
+  }
+  dev_err(core->dev, "SQ2 probe=%d stop=%d; independent owner retained\n", ret, stop);
+  return ret;
+ }
+ if (core->priv) hfi_destroy(core);
+ platform_set_drvdata(pdev, NULL);
+ mutex_destroy(&core->pm_lock);
+ mutex_destroy(&core->lock);
+ stop = sq2_venus_platform_release(&owner);
+ if (stop) dev_err(&pdev->dev, "SQ2 release=%d; retained\n", stop);
+ return ret;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-crop.h b/drivers/media/platform/qcom/venus/venus-sq2-crop.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-crop.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-crop.h	2026-11-20 21:12:16.539428004 +0100
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_CROP_H
+#define VENUS_SQ2_CROP_H
+/* A capture format switch after SOURCE_CHANGE must not replace the firmware's
+ * visible rectangle with the allocation's aligned dimensions. No scaling or
+ * guessed crop: preserve only an existing, bounded rectangle at identical size.
+ */
+static bool venus_sq2_keep_crop(struct venus_inst *inst, u32 type,
+                              u32 width, u32 height)
+{
+ const struct v4l2_rect *r = &inst->crop;
+ if (!IS_SQ2_HFI(inst->core) || !inst->reconfig ||
+     type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE ||
+     width != inst->width || height != inst->height ||
+     r->left < 0 || r->top < 0 || !r->width || !r->height)
+  return false;
+ return (u32)r->left < width && (u32)r->top < height &&
+        r->width <= width - (u32)r->left &&
+        r->height <= height - (u32)r->top;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-firmware.h b/drivers/media/platform/qcom/venus/venus-sq2-firmware.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-firmware.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-firmware.h	2026-11-20 21:12:16.547205850 +0100
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Called with powered Iris1 resources and serialized by the Venus core owner.
+ * Firmware memory alone is quarantined here. Platform match remains disabled
+ * until core/HFI/IRQ/devres lifetime is adapted too.
+ */
+#ifndef VENUS_SQ2_FIRMWARE_H
+#define VENUS_SQ2_FIRMWARE_H
+static bool sq2_no_tz;
+module_param(sq2_no_tz, bool, 0600);
+static int venus_sq2_shutdown(struct venus_core *core)
+{
+ int ret = sq2_venus_fw_shutdown(&core->sq2_fw_owner);
+ if (core->sq2_secure_active) {
+  ret = sq2_venus_platform_secure_end(core->sq2_platform, ret);
+  if (!ret) core->sq2_secure_active = false;
+#ifdef SQ2_VENUS_SYSTEM_PM
+  if (!ret) core->sq2_no_tz_active = false;
+#endif
+ }
+ return ret;
+}
+
+static int venus_sq2_boot(struct venus_core *core)
+{
+ const struct venus_resources *res = core->res;
+ int ret, stop;
+
+ if (!core->use_tz || !IS_IRIS1(core) || !IS_V4(core) || !res->cp_size)
+  return -EINVAL;
+ if (!core->sq2_platform)
+  return -ENODEV;
+ /* Do not repeat the known-failing second start in error recovery. */
+ if (core->sq2_boot_attempted || core->sq2_fw_owner)
+  return -EBUSY;
+ ret = sq2_venus_platform_secure_begin(core->sq2_platform);
+ if (ret) return ret;
+ core->sq2_secure_active = true;
+ core->sq2_boot_attempted = true;
+ if (!sq2_no_tz) venus_iris1_clock_config(core);
+ ret = sq2_venus_fw_boot(core->dev, &core->sq2_fw_owner, true,
+                        sq2_no_tz ? core->base : NULL);
+ if (ret) {
+  /* NULL owner proves no secure lease remains. A quarantined owner's stop
+   * returns its stored failure without issuing another PAS call. */
+  stop = venus_sq2_shutdown(core);
+  if (stop)
+   dev_err(core->dev, "SQ2 boot=%d shutdown=%d; platform retained\n", ret, stop);
+  return ret;
+ }
+
+#ifdef SQ2_VENUS_SYSTEM_PM
+ core->sq2_no_tz_active = sq2_no_tz;
+#endif
+ if (sq2_no_tz) return 0;
+ ret = qcom_scm_mem_protect_video_var(res->cp_start, res->cp_size,
+                                    res->cp_nonpixel_start, res->cp_nonpixel_size);
+ if (ret) {
+  stop = venus_sq2_shutdown(core);
+  if (stop)
+   dev_err(core->dev, "SQ2 protection=%d shutdown=%d; firmware owner retained\n",
+           ret, stop);
+ }
+ return ret;
+}
+
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-frame-sizes.h b/drivers/media/platform/qcom/venus/venus-sq2-frame-sizes.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-frame-sizes.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-frame-sizes.h	2026-11-20 21:12:16.556885511 +0100
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_FRAME_SIZES_H
+#define VENUS_SQ2_FRAME_SIZES_H
+/* ENUM_FRAMESIZES describes the requested compressed format, not the active
+ * session's codec. Do not mutate inst->hfi_codec to answer a read-only query. */
+static int venus_sq2_enum_sizes(struct venus_core *core,struct v4l2_frmsizeenum *f)
+{
+ u32 codec,i;const struct hfi_plat_caps *c;
+ const struct hfi_capability *w=NULL,*h=NULL;
+ switch(f->pixel_format){
+ case V4L2_PIX_FMT_H264:codec=HFI_VIDEO_CODEC_H264;break;
+ case V4L2_PIX_FMT_HEVC:codec=HFI_VIDEO_CODEC_HEVC;break;
+ case V4L2_PIX_FMT_VP8:codec=HFI_VIDEO_CODEC_VP8;break;
+ case V4L2_PIX_FMT_VP9:codec=HFI_VIDEO_CODEC_VP9;break;
+ case V4L2_PIX_FMT_MPEG1:codec=HFI_VIDEO_CODEC_MPEG1;break;
+ case V4L2_PIX_FMT_MPEG2:codec=HFI_VIDEO_CODEC_MPEG2;break;
+ default:return -EINVAL;
+ }
+ if(f->index)return -EINVAL;
+ c=venus_caps_by_codec(core,codec,VIDC_SESSION_TYPE_DEC);if(!c)return -EINVAL;
+ for(i=0;i<c->num_caps;i++){
+  if(c->caps[i].capability_type==HFI_CAPABILITY_FRAME_WIDTH)w=&c->caps[i];
+  if(c->caps[i].capability_type==HFI_CAPABILITY_FRAME_HEIGHT)h=&c->caps[i];
+ }
+ if(!w||!h||!w->step_size||!h->step_size||w->min>w->max||h->min>h->max)return -EINVAL;
+ f->type=V4L2_FRMSIZE_TYPE_STEPWISE;
+ f->stepwise.min_width=w->min;f->stepwise.max_width=w->max;f->stepwise.step_width=w->step_size;
+ f->stepwise.min_height=h->min;f->stepwise.max_height=h->max;f->stepwise.step_height=h->step_size;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-intbuf.h b/drivers/media/platform/qcom/venus/venus-sq2-intbuf.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-intbuf.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-intbuf.h	2026-11-20 21:12:16.565727837 +0100
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after struct intbuf in helpers.c. No callback retains inst/IDA. */
+#ifndef VENUS_SQ2_INTBUF_H
+#define VENUS_SQ2_INTBUF_H
+static void *sq2_intbuf_alloc(struct venus_inst *inst, struct intbuf *buf)
+{
+ void *va;
+ buf->sq2_core = inst->core;
+ if (IS_SQ2_HFI(inst->core)) {
+  if (sq2_venus_vb2_reserve(inst->core, buf->size)) return NULL;
+  buf->sq2_charged = buf->size;
+ }
+ va = dma_alloc_attrs(inst->core->dev, buf->size, &buf->da, GFP_KERNEL, buf->attrs);
+ if (!va && buf->sq2_charged) {
+  sq2_venus_vb2_unreserve(inst->core, buf->sq2_charged);
+  buf->sq2_charged = 0;
+ }
+ return va;
+}
+
+static void sq2_intbuf_dma_free(struct venus_inst *inst, struct intbuf *buf)
+{
+ dma_free_attrs(inst->core->dev, buf->size, buf->va, buf->da, buf->attrs);
+ if (buf->sq2_charged) {
+  sq2_venus_vb2_unreserve(buf->sq2_core, buf->sq2_charged);
+  buf->sq2_charged = 0;
+ }
+}
+
+static void sq2_intbuf_release(struct sq2_venus_retired *entry)
+{
+ struct intbuf *buf = container_of(entry, struct intbuf, sq2_retired);
+ struct device *dev = buf->sq2_dev;
+ dma_free_attrs(dev, buf->size, buf->va, buf->da, buf->attrs);
+ if (buf->sq2_charged) sq2_venus_vb2_unreserve(buf->sq2_core, buf->sq2_charged);
+ kfree(buf);
+ put_device(dev);
+}
+
+static void sq2_intbuf_retire(struct venus_inst *inst, struct intbuf *buf)
+{
+ if (buf->list.next) list_del_init(&buf->list);
+ else INIT_LIST_HEAD(&buf->list); /* failed SET before list insertion */
+ buf->sq2_dev = get_device(inst->core->dev);
+ INIT_LIST_HEAD(&buf->sq2_retired.list);
+ buf->sq2_retired.release = sq2_intbuf_release;
+ sq2_venus_retire(inst->core, &buf->sq2_retired);
+}
+
+/* Called after unlinking the HFI instance, before freeing inst. This includes
+ * FIRMWARE-owned DPBs skipped by the stock normal free helper. They remain
+ * DMA-mapped, with device and core ownership, until confirmed PAS stop.
+ */
+void venus_helper_sq2_retire_buffers(struct venus_inst *inst)
+{
+ struct intbuf *buf, *next;
+ if (!IS_SQ2_HFI(inst->core)) return;
+ list_for_each_entry_safe(buf, next, &inst->dpbbufs, list)
+  sq2_intbuf_retire(inst, buf);
+ list_for_each_entry_safe(buf, next, &inst->internalbufs, list)
+  sq2_intbuf_retire(inst, buf);
+}
+EXPORT_SYMBOL_GPL(venus_helper_sq2_retire_buffers);
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-min-output.h b/drivers/media/platform/qcom/venus/venus-sq2-min-output.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-min-output.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-min-output.h	2026-11-20 21:12:16.575979611 +0100
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Only publish an actual initialized HFI session's input-buffer requirement.
+ * Opening a device or setting its format is not an HFI SESSION_INIT. */
+#ifndef VENUS_SQ2_MIN_OUTPUT_H
+#define VENUS_SQ2_MIN_OUTPUT_H
+static int venus_sq2_min_output_ctrl(struct venus_inst *inst,
+                                    struct v4l2_ctrl *ctrl)
+{
+ struct hfi_buffer_requirements req;
+ enum hfi_version version = inst->core->res->hfi_version;
+ u32 count;
+ int ret;
+ if (inst->state == INST_UNINIT) return -EAGAIN;
+ ret = venus_helper_get_bufreq(inst, HFI_BUFFER_INPUT, &req);
+ if (ret) return ret;
+ count = hfi_bufreq_get_count_min(&req, version);
+ if (count > ctrl->maximum) return -ERANGE;
+ ctrl->val = count;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-omx-flags.h b/drivers/media/platform/qcom/venus/venus-sq2-omx-flags.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-omx-flags.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-omx-flags.h	2026-11-20 21:12:16.584329204 +0100
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_OMX_FLAGS_H
+#define VENUS_SQ2_OMX_FLAGS_H
+/* Downstream 0x20000 overlaps upstream timestamp-source bits. */
+#define SQ2_V4L2_BUF_FLAG_CODECCONFIG 0x01000000U
+static inline u32 sq2_omx_input_flags(u32 flags)
+{
+ return flags & SQ2_V4L2_BUF_FLAG_CODECCONFIG ? HFI_BUFFERFLAG_CODECCONFIG : 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-omx.h b/drivers/media/platform/qcom/venus/venus-sq2-omx.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-omx.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-omx.h	2026-11-20 21:12:16.592192678 +0100
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_OMX_H
+#define VENUS_SQ2_OMX_H
+/* The standard resolution bit stays first. Additional words carry actual HFI
+ * sequence fields and their presence mask; old V4L2 clients ignore them. */
+static void sq2_omx_sequence(struct v4l2_event *event,
+                            const struct hfi_event_data *data)
+{
+ u32 payload[] = { V4L2_EVENT_SRC_CH_RESOLUTION, 0x51324d31,
+                  data->sq2_sequence_fields, data->height, data->width,
+                  data->bit_depth, data->pic_struct, data->colour_space };
+ memcpy(event->u.data, payload, sizeof(payload));
+}
+
+/* Called with the state lock held by the sequence callback. A blocking OMX
+ * flush must let that callback run without issuing a second shared completion. */
+static int sq2_omx_flush_output(struct venus_inst *inst)
+{
+ if (inst->sq2_omx_flush_flags) {
+  if (!(inst->sq2_omx_flush_flags & 2))
+   inst->sq2_omx_flush_output_pending = true;
+  return 0;
+ }
+ return hfi_session_flush(inst, HFI_FLUSH_OUTPUT, false);
+}
+
+/* Private downstream FLUSH. Completion means an acknowledged HFI flush,
+ * then release of any still-software-owned buffers, never a guessed event. */
+static int sq2_omx_flush(struct venus_inst *inst, u32 flags)
+{
+ struct vb2_v4l2_buffer *buffer;
+ u32 type;
+ bool output_flushed;
+ int ret;
+ if (!flags || (flags & ~3U)) return -EINVAL;
+ if (!IS_SQ2_HFI(inst->core)) return -EOPNOTSUPP;
+ /* Queue ioctls stay serialized while the IRQ callback takes the state lock. */
+ mutex_lock(&inst->ctx_q_lock);
+ mutex_lock(&inst->lock);
+ if (inst->session_error ||
+     test_bit(0, &inst->core->sys_error)) {
+  ret = -EIO;
+  goto out;
+ }
+ /* Before OUTPUT's first queued buffer starts HFI, CAPTURE buffers can
+  * already be queued by OMX prewarming. They are exclusively software-owned;
+  * return them through VB2 without sending FLUSH to a non-started firmware
+  * session. Never use this path after a stream has actually started. */
+ if ((inst->state == INST_UNINIT || inst->state == INST_INIT) &&
+     inst->codec_state == VENUS_DEC_STATE_DEINIT &&
+     !inst->streamon_out && !inst->streamon_cap) {
+  output_flushed = false;
+  ret = 0;
+  goto release_software;
+ }
+ if (inst->state != INST_START) {
+  ret = -EIO;
+  goto out;
+ }
+ type = flags == 3 ? HFI_FLUSH_ALL :
+        flags == 1 ? HFI_FLUSH_INPUT : HFI_FLUSH_OUTPUT;
+ inst->sq2_omx_flush_flags = flags;
+ inst->sq2_omx_flush_output_pending = false;
+ mutex_unlock(&inst->lock);
+ ret = hfi_session_flush(inst, type, true);
+ mutex_lock(&inst->lock);
+ if (!ret && inst->sq2_omx_flush_output_pending) {
+  /* An input-only flush cannot acknowledge a DRC output flush. */
+  inst->sq2_omx_flush_flags |= 2;
+  mutex_unlock(&inst->lock);
+  ret = hfi_session_flush(inst, HFI_FLUSH_OUTPUT, true);
+  mutex_lock(&inst->lock);
+ }
+ output_flushed = (inst->sq2_omx_flush_flags & 2) != 0;
+ inst->sq2_omx_flush_flags = 0;
+ inst->sq2_omx_flush_output_pending = false;
+ if (ret) goto out;
+ if (inst->session_error || test_bit(0, &inst->core->sys_error)) {
+  ret = -EIO;
+  goto out;
+ }
+release_software:
+ /* Before start no buffer was submitted; otherwise HFI acknowledged FLUSH. */
+ /* The real firmware has returned ownership. Only buffers still on the
+  * software queue remain here; completed buffers were removed by callbacks. */
+ if (flags & 1)
+  while ((buffer = v4l2_m2m_src_buf_remove(inst->m2m_ctx))) {
+   vb2_set_plane_payload(&buffer->vb2_buf, 0, 0);
+   buffer->flags = 0;
+   v4l2_m2m_buf_done(buffer, VB2_BUF_STATE_DONE);
+  }
+ if (flags & 2) {
+  /* A completed EOS latch otherwise hides real buffers returned by FLUSH. */
+  vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(inst->m2m_ctx));
+  while ((buffer = v4l2_m2m_dst_buf_remove(inst->m2m_ctx))) {
+   vb2_set_plane_payload(&buffer->vb2_buf, 0, 0);
+   buffer->flags = 0;
+   v4l2_m2m_buf_done(buffer, VB2_BUF_STATE_DONE);
+  }
+ }
+ if ((flags & 1) && (flags & 2))
+  memset(inst->tss, 0, sizeof(inst->tss));
+ if ((flags & 1) && inst->streamon_cap &&
+     (inst->codec_state == VENUS_DEC_STATE_DRAIN ||
+      inst->codec_state == VENUS_DEC_STATE_STOPPED)) {
+  inst->drain_active = false;
+  inst->codec_state = VENUS_DEC_STATE_DECODING;
+ }
+ /* Flushing output/all returns internal DPB buffers from firmware too. Re-queue
+  * them when capture remains active (not before start or mid-DRC teardown). */
+ if (output_flushed && inst->streamon_cap &&
+     inst->codec_state != VENUS_DEC_STATE_DRC)
+  ret = venus_helper_queue_dpb_bufs(inst);
+out:
+ mutex_unlock(&inst->lock);
+ mutex_unlock(&inst->ctx_q_lock);
+ return ret;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-resources.h b/drivers/media/platform/qcom/venus/venus-sq2-resources.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-resources.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-resources.h	2026-11-20 21:12:16.599046206 +0100
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Explicit laboratory match, not an alias for stock SC8180X or SM8150.
+ * Clock/reset/ICC are owned by sq2-venus-power, not stock PM frequency tables.
+ * HFI4 queries firmware for buffer requirements and codec capabilities.
+ * Protection values exactly match the successful six-frame private test.
+ */
+static const struct venus_resources sq2_lab_res = {
+ .iris1 = true,
+ .sq2_windows_hfi = true,
+ .hfi_version = HFI_VERSION_4XX,
+ .dma_mask = DMA_BIT_MASK(32),
+ .vmem_id = VIDC_RESOURCE_NONE,
+ .cp_start = 0,
+ .cp_size = 0x25800000,
+ .cp_nonpixel_start = 0x1000000,
+ .cp_nonpixel_size = 0x24800000,
+ .fwname = "qcom/venus-5.2/venus.mbn",
+};
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-session-end.h b/drivers/media/platform/qcom/venus/venus-sq2-session-end.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-session-end.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-session-end.h	2026-11-20 21:12:16.606101618 +0100
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_SESSION_END_H
+#define VENUS_SQ2_SESSION_END_H
+/* Caller serializes session operations. A timed-out END cannot be retried or
+ * used to authorize DMA reclamation. The reply has its own completion/error. */
+static int sq2_session_end(struct venus_inst *inst)
+{
+ int ret;
+ if (test_bit(0, &inst->core->sys_error)) return -EIO;
+ if (inst->sq2_end_confirmed) return 0;
+ if (inst->sq2_end_sent) return -EIO;
+ if (inst->state == INST_UNINIT) return 0; /* no confirmation is fabricated */
+ if (inst->state < INST_INIT) return -EINVAL;
+ reinit_completion(&inst->sq2_end_done);
+ inst->sq2_end_error = HFI_ERR_NONE;
+ inst->sq2_end_sent = true;
+ ret = inst->core->ops->session_end(inst);
+ if (ret) return ret;
+ if (!wait_for_completion_timeout(&inst->sq2_end_done, TIMEOUT)) return -ETIMEDOUT;
+ /* A successful END confirms teardown even after an earlier session error.
+  * Preserve that error for clients; it does not invalidate this separate reply. */
+ if (inst->sq2_end_error != HFI_ERR_NONE ||
+     test_bit(0, &inst->core->sys_error)) return -EIO;
+ inst->sq2_end_confirmed = true;
+ sq2_venus_scope_end(inst);
+ inst->state = INST_UNINIT;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-system-pm.h b/drivers/media/platform/qcom/venus/venus-sq2-system-pm.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-system-pm.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-system-pm.h	2026-11-20 21:12:16.612241255 +0100
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after venus-sq2-core.h. System sleep only: runtime PM stays resident.
+ * Stop CPU and verify DMA unmap BEFORE freeing HFI; retain platform handles and
+ * genpd attachments through the PM walk. Only a proven clean stop grants one
+ * restart on resume. A failed stop/start remains quarantined until reboot. */
+#ifndef VENUS_SQ2_SYSTEM_PM_INTEGRATION_H
+#define VENUS_SQ2_SYSTEM_PM_INTEGRATION_H
+#include "hfi_venus.h"
+
+/* Published SQ2 cores and this module remain pinned until reboot. Read-only
+ * observations do not clear errors or request firmware/PM transitions. */
+static struct venus_core *sq2_pm_status_core;
+#include "venus-sq2-avc-export.h"
+static const char *sq2_pm_stage = "probe";
+static void venus_sq2_pm_publish(struct venus_core *core)
+{
+ WRITE_ONCE(sq2_pm_status_core, core);
+}
+static int venus_sq2_pm_status_get(char *buf, const struct kernel_param *kp)
+{
+ struct venus_core *core = READ_ONCE(sq2_pm_status_core);
+ int n;
+ (void)kp;
+ if (!core) return scnprintf(buf, PAGE_SIZE, "unpublished\n");
+ mutex_lock(&core->pm_lock);
+ mutex_lock(&core->lock);
+ mutex_lock(&core->sq2_retire_lock);
+ n = scnprintf(buf, PAGE_SIZE,
+  "stage=%s phase=%u error=%d sys_error=%d core_state=%u hfi_error=%u fw_owner=%d secure=%d no_tz=%d hfi=%d dma_stopped=%d insts=%d vb2_bytes=%llu stops=%lu starts=%lu\n",
+  READ_ONCE(sq2_pm_stage), core->sq2_system_pm.phase, core->sq2_system_pm.error,
+  !!test_bit(0, &core->sys_error), core->state, core->error,
+  !!core->sq2_fw_owner, core->sq2_secure_active, core->sq2_no_tz_active,
+  !!core->priv, core->sq2_dma_stopped, atomic_read(&core->insts_count),
+  (unsigned long long)core->sq2_vb2_bytes,
+  core->sq2_system_pm.stops, core->sq2_system_pm.starts);
+ mutex_unlock(&core->sq2_retire_lock);
+ mutex_unlock(&core->lock);
+ mutex_unlock(&core->pm_lock);
+ return n;
+}
+static const struct kernel_param_ops sq2_pm_status_ops = {
+ .get = venus_sq2_pm_status_get,
+};
+module_param_cb(sq2_pm_status, &sq2_pm_status_ops, NULL, 0400);
+static int venus_sq2_pm_result(struct venus_core *core, const char *stage, int ret)
+{
+ WRITE_ONCE(sq2_pm_stage, stage);
+ if (ret)
+  dev_err(core->dev, "SQ2_SYSTEM_PM stage=%s ret=%d phase=%u sys_error=%d core_state=%u hfi_error=%u fw_owner=%d secure=%d hfi=%d\n",
+   stage, ret, core->sq2_system_pm.phase, !!test_bit(0, &core->sys_error),
+   core->state, core->error, !!core->sq2_fw_owner,
+   core->sq2_secure_active, !!core->priv);
+ return ret;
+}
+
+
+static int venus_sq2_pm_idle(void *data)
+{
+ struct venus_core *core = data;
+ int ret = 0;
+ mutex_lock(&core->lock);
+ if (!core->sq2_no_tz_active) ret = -EOPNOTSUPP;
+ else if (test_bit(0, &core->sys_error) || core->state != CORE_INIT ||
+          core->error != HFI_ERR_NONE || !core->priv ||
+          !core->sq2_fw_owner || !core->sq2_secure_active) ret = -EIO;
+ else if (!list_empty(&core->instances) || atomic_read(&core->insts_count))
+  ret = -EBUSY;
+ mutex_unlock(&core->lock);
+ mutex_lock(&core->sq2_retire_lock);
+ /* Retired buffers are firmware-owned until a confirmed CPU stop. They
+  * must not block the very stop that makes their reclamation safe. */
+ if (!ret && core->sq2_dma_stopped) ret = -EIO;
+ mutex_unlock(&core->sq2_retire_lock);
+ return ret;
+}
+
+static int venus_sq2_pm_stop(void *data)
+{
+ struct venus_core *core = data;
+ int ret;
+ /* STOPPING already excludes new sessions; do not reset a live firmware
+  * before the existing HFI idle/PC_READY handshake has completed. */
+ cancel_delayed_work_sync(&core->work);
+ ret = venus_sq2_pm_result(core, "stop:prepare-pc",
+  venus_hfi_prepare_system_stop(core));
+ if (ret) return ret;
+ ret = venus_sq2_pm_result(core, "stop:irq-disable",
+  sq2_venus_platform_irq(core->sq2_platform, false));
+ if (ret) return ret;
+ cancel_delayed_work_sync(&core->work);
+ ret = venus_sq2_pm_result(core, "stop:recheck-idle", venus_sq2_pm_idle(core));
+ if (ret) {
+  if (ret == -EBUSY) {
+   ret = venus_sq2_pm_result(core, "stop:busy-irq-restore",
+    sq2_venus_platform_irq(core->sq2_platform, true));
+   if (!ret) return SQ2_PM_STOP_UNCHANGED_BUSY;
+  }
+  return ret;
+ }
+ /* This path asserts no-TZ reset, confirms the complete 5MiB unmap and
+  * releases the firmware lease. It never requests a second PAS start. */
+ ret = venus_sq2_pm_result(core, "stop:firmware-shutdown", venus_shutdown(core));
+ if (ret) return ret;
+ if (core->sq2_fw_owner || core->sq2_secure_active)
+  return venus_sq2_pm_result(core, "stop:owner-retained", -EUCLEAN);
+ ret = venus_sq2_pm_result(core, "stop:hfi-deinit", hfi_core_deinit(core, false));
+ if (ret) return ret;
+ hfi_destroy(core);
+ sq2_venus_retire_stopped(core);
+ mutex_lock(&core->sq2_retire_lock);
+ ret = (core->sq2_vb2_bytes || !list_empty(&core->sq2_retired)) ? -EUCLEAN : 0;
+ mutex_unlock(&core->sq2_retire_lock);
+ /* Unknown live backing is retained with the stopped owner; never silently
+  * discard charges or authorize a restart with unreconciled DMA ownership. */
+ if (ret) return venus_sq2_pm_result(core, "stop:retired-buffers", ret);
+ return venus_sq2_pm_result(core, "stop:power-quiet",
+  sq2_venus_platform_system_quiet(core->sq2_platform));
+}
+
+static int venus_sq2_pm_start(void *data)
+{
+ struct venus_core *core = data;
+ int ret, stop, quiet;
+ if (core->priv || core->sq2_fw_owner || core->sq2_secure_active)
+  return venus_sq2_pm_result(core, "start:owner-retained", -EUCLEAN);
+ ret = venus_sq2_pm_result(core, "start:power-restore",
+  sq2_venus_platform_system_restore(core->sq2_platform));
+ if (ret) goto fail;
+ ret = venus_sq2_pm_result(core, "start:hfi-create",
+  hfi_create(core, &venus_core_ops));
+ if (ret) goto fail;
+ mutex_lock(&core->sq2_retire_lock);
+ if (core->sq2_vb2_bytes || !list_empty(&core->sq2_retired)) {
+  mutex_unlock(&core->sq2_retire_lock);
+  ret = -EUCLEAN; goto fail;
+ }
+ core->sq2_dma_stopped = false;
+ mutex_unlock(&core->sq2_retire_lock);
+ /* Only SQ2_PM_OFF reaches this callback, after complete verified stop. */
+ core->sq2_boot_attempted = false;
+ ret = venus_sq2_pm_result(core, "start:firmware-boot",
+  venus_boot(core));
+ if (ret) goto fail;
+ ret = venus_sq2_pm_result(core, "start:hfi-resume",
+  hfi_core_resume(core, true));
+ if (ret) goto fail;
+ ret = venus_sq2_pm_result(core, "start:irq-enable",
+  sq2_venus_platform_irq(core->sq2_platform, true));
+ if (ret) goto fail;
+ ret = venus_sq2_pm_result(core, "start:hfi-init",
+  hfi_core_init(core));
+ if (ret) goto fail;
+ ret = venus_sq2_pm_result(core, "start:enumerate",
+  venus_enumerate_codecs(core, VIDC_SESSION_TYPE_DEC));
+ if (ret) goto fail;
+ if (test_bit(0, &core->sys_error)) {
+  ret = venus_sq2_pm_result(core, "start:sys-error", -EIO); goto fail;
+ }
+ WRITE_ONCE(sq2_pm_stage, "start:ready");
+ return 0;
+fail:
+ sq2_venus_platform_irq(core->sq2_platform, false);
+ cancel_delayed_work_sync(&core->work);
+ stop = venus_shutdown(core);
+ quiet = -EBUSY;
+ if (!stop && !core->sq2_fw_owner && !core->sq2_secure_active) {
+  if (core->priv && !hfi_core_deinit(core, false)) hfi_destroy(core);
+  sq2_venus_retire_stopped(core);
+  quiet = sq2_venus_platform_system_quiet(core->sq2_platform);
+ }
+ set_bit(0, &core->sys_error);
+ dev_err(core->dev, "SQ2_SYSTEM_PM restart=%d cleanup=%d quiet=%d; no retry, owner retained\n",
+         ret, stop, quiet);
+ return ret;
+}
+static const struct sq2_system_pm_ops venus_sq2_system_ops = {
+ .idle = venus_sq2_pm_idle, .stop = venus_sq2_pm_stop, .start = venus_sq2_pm_start,
+};
+static __maybe_unused int venus_sq2_system_suspend(struct device *dev)
+{
+ struct venus_core *core = dev_get_drvdata(dev);
+ int ret;
+ if (!IS_SQ2_HFI(core)) return pm_runtime_force_suspend(dev);
+ mutex_lock(&core->pm_lock);
+ ret = sq2_system_pm_suspend(&core->sq2_system_pm, &venus_sq2_system_ops, core);
+ if (ret && core->sq2_system_pm.phase == SQ2_PM_BROKEN)
+  set_bit(0, &core->sys_error);
+ mutex_unlock(&core->pm_lock);
+ return ret;
+}
+static __maybe_unused int venus_sq2_system_resume(struct device *dev)
+{
+ struct venus_core *core = dev_get_drvdata(dev);
+ int ret;
+ if (!IS_SQ2_HFI(core)) return pm_runtime_force_resume(dev);
+ mutex_lock(&core->pm_lock);
+ ret = sq2_system_pm_resume(&core->sq2_system_pm, &venus_sq2_system_ops, core);
+ mutex_unlock(&core->pm_lock);
+ return ret;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-vb2.h b/drivers/media/platform/qcom/venus/venus-sq2-vb2.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-vb2.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-vb2.h	2026-11-20 21:12:16.619269634 +0100
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included in vdec.c. Backing allocations and imported mappings survive VB2
+ * teardown until their bound session END or PAS stop is confirmed. Objects
+ * reused by a new session are rebound at HFI submission, not allocation.
+ * Standard platforms retain vb2_dma_contig_memops unchanged.
+ */
+#ifndef VENUS_SQ2_VB2_H
+#define VENUS_SQ2_VB2_H
+#ifndef SQ2_VENUS_VB2_HOST_TEST
+#include <linux/dma-buf.h>
+#endif
+#include "sq2-venus-retire.h"
+struct sq2_vb2_lease {
+ struct sq2_venus_retired retired;
+ struct venus_core *core;
+ void *backing;
+ struct dma_buf *dbuf;
+ bool mapped;
+ unsigned long charged;
+};
+
+static void sq2_vb2_release(struct sq2_venus_retired *entry)
+{
+ struct sq2_vb2_lease *lease = container_of(entry, struct sq2_vb2_lease, retired);
+ /* These allocator operations do not dereference the old vb2_buffer. */
+ if (lease->dbuf) {
+  if (lease->mapped) vb2_dma_contig_memops.unmap_dmabuf(lease->backing);
+  vb2_dma_contig_memops.detach_dmabuf(lease->backing);
+  dma_buf_put(lease->dbuf);
+ } else {
+  vb2_dma_contig_memops.put(lease->backing);
+ }
+ sq2_venus_vb2_unreserve(lease->core, lease->charged);
+ kfree(lease);
+ module_put(THIS_MODULE);
+}
+
+static struct sq2_vb2_lease *sq2_vb2_new(struct vb2_buffer *vb, unsigned long bytes)
+{
+ struct venus_inst *inst = vb2_get_drv_priv(vb->vb2_queue);
+ struct sq2_vb2_lease *lease;
+ int ret;
+ if (!try_module_get(THIS_MODULE)) return ERR_PTR(-ENODEV);
+ lease = kzalloc(sizeof(*lease), GFP_KERNEL);
+ if (!lease) { module_put(THIS_MODULE); return ERR_PTR(-ENOMEM); }
+ lease->core = inst->core;
+ ret = sq2_venus_vb2_reserve(inst->core, bytes);
+ if (ret) { kfree(lease); module_put(THIS_MODULE); return ERR_PTR(ret); }
+ lease->charged = bytes;
+ INIT_LIST_HEAD(&lease->retired.list);
+ lease->retired.release = sq2_vb2_release;
+ return lease;
+}
+
+static void sq2_vb2_failed(struct sq2_vb2_lease *lease)
+{
+ sq2_venus_vb2_unreserve(lease->core, lease->charged);
+ kfree(lease);
+ module_put(THIS_MODULE);
+}
+
+static void *sq2_vb2_alloc(struct vb2_buffer *vb, struct device *dev, unsigned long size)
+{
+ struct sq2_vb2_lease *lease = sq2_vb2_new(vb, size);
+ void *backing;
+ if (IS_ERR(lease)) return lease;
+ backing = vb2_dma_contig_memops.alloc(vb, dev, size);
+ if (IS_ERR_OR_NULL(backing)) { sq2_vb2_failed(lease); return backing; }
+ lease->backing = backing;
+ return lease;
+}
+
+static void *sq2_vb2_attach(struct vb2_buffer *vb, struct device *dev,
+                           struct dma_buf *dbuf, unsigned long size)
+{
+ /* The attachment maps the exporter's full sg_table, not just size bytes. */
+ struct sq2_vb2_lease *lease = sq2_vb2_new(vb, dbuf->size);
+ void *backing;
+ if (IS_ERR(lease)) return lease;
+ /* VB2 drops its reference after detach, even when our release is deferred. */
+ get_dma_buf(dbuf);
+ backing = vb2_dma_contig_memops.attach_dmabuf(vb, dev, dbuf, size);
+ if (IS_ERR_OR_NULL(backing)) {
+  dma_buf_put(dbuf); sq2_vb2_failed(lease); return backing;
+ }
+ lease->backing = backing;
+ lease->dbuf = dbuf;
+ return lease;
+}
+
+static int sq2_vb2_map(void *mem)
+{
+ struct sq2_vb2_lease *lease = mem;
+ int ret;
+ if (lease->mapped) return 0;
+ ret = vb2_dma_contig_memops.map_dmabuf(lease->backing);
+ if (!ret) lease->mapped = true;
+ return ret;
+}
+
+static void sq2_vb2_unmap(void *mem)
+{
+ /* Keep the same mapping even across dqbuf/requeue. Detach transfers it to
+  * the core retirement list; confirmed session END or PAS stop releases it. */
+ (void)mem;
+}
+
+static void sq2_vb2_retire(void *mem)
+{
+ struct sq2_vb2_lease *lease = mem;
+ /* VB2 serializes detach against submission; no scope means no HFI publication. */
+ if (!lease->retired.scope) sq2_vb2_release(&lease->retired);
+ else sq2_venus_retire(lease->core, &lease->retired);
+}
+
+static void sq2_vb2_prepare(void *mem)
+{ struct sq2_vb2_lease *l = mem; vb2_dma_contig_memops.prepare(l->backing); }
+static void sq2_vb2_finish(void *mem)
+{ struct sq2_vb2_lease *l = mem; vb2_dma_contig_memops.finish(l->backing); }
+static void *sq2_vb2_cookie(struct vb2_buffer *vb, void *mem)
+{ struct sq2_vb2_lease *l = mem; return vb2_dma_contig_memops.cookie(vb, l->backing); }
+static void *sq2_vb2_vaddr(struct vb2_buffer *vb, void *mem)
+{ struct sq2_vb2_lease *l = mem; return vb2_dma_contig_memops.vaddr(vb, l->backing); }
+static unsigned int sq2_vb2_users(void *mem)
+{ struct sq2_vb2_lease *l = mem; return vb2_dma_contig_memops.num_users(l->backing); }
+static int sq2_vb2_mmap(void *mem, struct vm_area_struct *vma)
+{ struct sq2_vb2_lease *l = mem; return vb2_dma_contig_memops.mmap(l->backing, vma); }
+static struct dma_buf *sq2_vb2_export(struct vb2_buffer *vb, void *mem, unsigned long flags)
+{ struct sq2_vb2_lease *l = mem; return vb2_dma_contig_memops.get_dmabuf(vb, l->backing, flags); }
+
+static const struct vb2_mem_ops sq2_vb2_memops = {
+ .alloc = sq2_vb2_alloc, .put = sq2_vb2_retire, .get_dmabuf = sq2_vb2_export,
+ .attach_dmabuf = sq2_vb2_attach, .detach_dmabuf = sq2_vb2_retire,
+ .map_dmabuf = sq2_vb2_map, .unmap_dmabuf = sq2_vb2_unmap,
+ .prepare = sq2_vb2_prepare, .finish = sq2_vb2_finish,
+ .cookie = sq2_vb2_cookie, .vaddr = sq2_vb2_vaddr,
+ .num_users = sq2_vb2_users, .mmap = sq2_vb2_mmap,
+};
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/venus-sq2-vp9-eos.h b/drivers/media/platform/qcom/venus/venus-sq2-vp9-eos.h
--- a/drivers/media/platform/qcom/venus/venus-sq2-vp9-eos.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/venus-sq2-vp9-eos.h	2026-11-20 21:12:16.628503856 +0100
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef VENUS_SQ2_VP9_EOS_H
+#define VENUS_SQ2_VP9_EOS_H
+
+/* SQ2 firmware returns a successful, empty VP9 drain marker with DROP_FRAME.
+ * Observed packet: error=0, bytes=offset=0, EOS|SYNCFRAME|DROP_FRAME.
+ * Normalize only this exact marker; preserve every other error/flag case.
+ * Caller must identify the SQ2 VP9 decoder, never an encoder or other SoC.
+ */
+static inline unsigned int
+venus_sq2_vp9_eos_flags(int sq2_vp9_decoder, unsigned int error,
+                       unsigned int bytes, unsigned int offset,
+                       unsigned int flags)
+{
+ if (sq2_vp9_decoder && !error && !bytes && !offset &&
+     flags == (HFI_BUFFERFLAG_EOS | HFI_BUFFERFLAG_SYNCFRAME |
+               HFI_BUFFERFLAG_DROP_FRAME))
+  return flags & ~HFI_BUFFERFLAG_DROP_FRAME;
+ return flags;
+}
+#endif
