diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-retire.c b/drivers/media/platform/qcom/venus/sq2-venus-retire.c
--- a/drivers/media/platform/qcom/venus/sq2-venus-retire.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-retire.c	2026-11-20 21:12:16.143939055 +0100
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_VENUS_RETIRE_HOST_TEST
+#include <linux/module.h>
+#include <linux/slab.h>
+#include "core.h"
+#endif
+#include "sq2-venus-retire.h"
+
+static void scope_put(struct sq2_venus_scope *scope)
+{
+ if (scope && refcount_dec_and_test(&scope->refs)) kfree(scope);
+}
+
+static void release_entry(struct sq2_venus_retired *entry)
+{
+ struct sq2_venus_scope *scope = entry->scope;
+ entry->release(entry);
+ scope_put(scope);
+}
+
+int sq2_venus_scope_begin(struct venus_inst *inst)
+{
+ struct venus_core *core = inst->core;
+ struct sq2_venus_scope *old, *scope = kzalloc(sizeof(*scope), GFP_KERNEL);
+ if (!scope) return -ENOMEM;
+ refcount_set(&scope->refs, 1);
+ mutex_lock(&core->sq2_retire_lock);
+ old = inst->sq2_scope;
+ if (core->sq2_dma_stopped || (old && !old->ended)) {
+  mutex_unlock(&core->sq2_retire_lock); kfree(scope); return -EIO;
+ }
+ inst->sq2_scope = scope;
+ mutex_unlock(&core->sq2_retire_lock);
+ scope_put(old);
+ return 0;
+}
+EXPORT_SYMBOL_GPL(sq2_venus_scope_begin);
+
+/* Binding happens before a buffer address is published to HFI. Active objects
+ * may survive END and be reused: only an ended old scope may be replaced. */
+int sq2_venus_scope_bind(struct venus_inst *inst, struct sq2_venus_retired *entry)
+{
+ struct venus_core *core = inst->core;
+ struct sq2_venus_scope *old, *scope;
+ mutex_lock(&core->sq2_retire_lock);
+ scope = inst->sq2_scope; old = entry->scope;
+ if (core->sq2_dma_stopped || !scope || scope->ended ||
+     (old && old != scope && !old->ended)) {
+  mutex_unlock(&core->sq2_retire_lock); return -EIO;
+ }
+ if (old != scope) { refcount_inc(&scope->refs); entry->scope = scope; }
+ mutex_unlock(&core->sq2_retire_lock);
+ if (old != scope) scope_put(old);
+ return 0;
+}
+EXPORT_SYMBOL_GPL(sq2_venus_scope_bind);
+
+bool sq2_venus_scope_ended(struct venus_inst *inst, struct sq2_venus_retired *entry)
+{
+ bool ended;
+ mutex_lock(&inst->core->sq2_retire_lock);
+ ended = entry->scope && entry->scope->ended;
+ mutex_unlock(&inst->core->sq2_retire_lock);
+ return ended;
+}
+EXPORT_SYMBOL_GPL(sq2_venus_scope_ended);
+
+void sq2_venus_scope_drop(struct venus_inst *inst)
+{
+ struct sq2_venus_scope *old;
+ mutex_lock(&inst->core->sq2_retire_lock);
+ old = inst->sq2_scope; inst->sq2_scope = NULL;
+ mutex_unlock(&inst->core->sq2_retire_lock);
+ scope_put(old);
+}
+EXPORT_SYMBOL_GPL(sq2_venus_scope_drop);
+
+void sq2_venus_scope_end(struct venus_inst *inst)
+{
+ struct venus_core *core = inst->core;
+ struct sq2_venus_retired *entry, *next;
+ LIST_HEAD(done);
+ mutex_lock(&core->sq2_retire_lock);
+ if (inst->sq2_scope) {
+  inst->sq2_scope->ended = true;
+  list_for_each_entry_safe(entry, next, &core->sq2_retired, list)
+   if (entry->scope == inst->sq2_scope) {
+    list_del_init(&entry->list); list_add_tail(&entry->list, &done);
+   }
+ }
+ mutex_unlock(&core->sq2_retire_lock);
+ list_for_each_entry_safe(entry, next, &done, list) {
+  list_del_init(&entry->list); release_entry(entry);
+ }
+}
+EXPORT_SYMBOL_GPL(sq2_venus_scope_end);
+
+void sq2_venus_retire_init(struct venus_core *core)
+{
+ INIT_LIST_HEAD(&core->sq2_retired);
+ mutex_init(&core->sq2_retire_lock);
+ core->sq2_dma_stopped = false;
+ core->sq2_vb2_bytes = 0;
+}
+
+int sq2_venus_vb2_reserve(struct venus_core *core, unsigned long bytes)
+{
+ int ret = 0;
+ mutex_lock(&core->sq2_retire_lock);
+ if (core->sq2_dma_stopped) ret = -EIO;
+ else if (!bytes || bytes > SQ2_VENUS_VB2_BUDGET ||
+          core->sq2_vb2_bytes > SQ2_VENUS_VB2_BUDGET - bytes) ret = -ENOSPC;
+ else core->sq2_vb2_bytes += bytes;
+ mutex_unlock(&core->sq2_retire_lock);
+ return ret;
+}
+EXPORT_SYMBOL_GPL(sq2_venus_vb2_reserve);
+
+void sq2_venus_vb2_unreserve(struct venus_core *core, unsigned long bytes)
+{
+ mutex_lock(&core->sq2_retire_lock);
+ if (!WARN_ON(bytes > core->sq2_vb2_bytes)) core->sq2_vb2_bytes -= bytes;
+ mutex_unlock(&core->sq2_retire_lock);
+}
+EXPORT_SYMBOL_GPL(sq2_venus_vb2_unreserve);
+
+void sq2_venus_retire(struct venus_core *core, struct sq2_venus_retired *entry)
+{
+ bool stopped;
+ mutex_lock(&core->sq2_retire_lock);
+ stopped = core->sq2_dma_stopped || (entry->scope && entry->scope->ended);
+ if (!stopped) list_add_tail(&entry->list, &core->sq2_retired);
+ mutex_unlock(&core->sq2_retire_lock);
+ if (stopped) release_entry(entry);
+}
+EXPORT_SYMBOL_GPL(sq2_venus_retire);
+
+void sq2_venus_retire_stopped(struct venus_core *core)
+{
+ LIST_HEAD(done);
+ struct sq2_venus_retired *entry, *next;
+ mutex_lock(&core->sq2_retire_lock);
+ core->sq2_dma_stopped = true;
+ list_splice_init(&core->sq2_retired, &done);
+ mutex_unlock(&core->sq2_retire_lock);
+ list_for_each_entry_safe(entry, next, &done, list) {
+  list_del_init(&entry->list);
+  release_entry(entry);
+ }
+}
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-retire.h b/drivers/media/platform/qcom/venus/sq2-venus-retire.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-retire.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-retire.h	2026-11-20 21:12:16.451914368 +0100
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SQ2_VENUS_RETIRE_H
+#define SQ2_VENUS_RETIRE_H
+#ifndef SQ2_VENUS_RETIRE_HOST_TEST
+#include <linux/list.h>
+#include <linux/refcount.h>
+#endif
+struct venus_core;
+struct venus_inst;
+struct sq2_venus_retired;
+struct sq2_venus_scope {
+ refcount_t refs;
+ bool ended; /* protected by core retirement lock; never reset */
+};
+int sq2_venus_scope_begin(struct venus_inst *);
+int sq2_venus_scope_bind(struct venus_inst *, struct sq2_venus_retired *);
+bool sq2_venus_scope_ended(struct venus_inst *, struct sq2_venus_retired *);
+void sq2_venus_scope_end(struct venus_inst *);
+void sq2_venus_scope_drop(struct venus_inst *);
+/* Lab memory containment, not a firmware capability/maximum frame size. Counts
+ * live AND retired VB2, DPB and internal backing until actual release.
+ * The vb2-named API is retained for existing callers; the budget is shared. */
+#define SQ2_VENUS_VB2_BUDGET (1UL << 30)
+int sq2_venus_vb2_reserve(struct venus_core *, unsigned long bytes);
+void sq2_venus_vb2_unreserve(struct venus_core *, unsigned long bytes);
+struct sq2_venus_retired {
+ struct sq2_venus_scope *scope;
+ struct list_head list;
+ void (*release)(struct sq2_venus_retired *);
+};
+/* Caller must not hold core->lock. Entries own every object used by release,
+ * including the callback module. No reference to an expired vb2_buffer/inst. */
+void sq2_venus_retire(struct venus_core *, struct sq2_venus_retired *);
+void sq2_venus_retire_init(struct venus_core *);
+/* Only after IRQ synchronization and a successful PAS stop. */
+void sq2_venus_retire_stopped(struct venus_core *);
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2-venus-system-pm.h b/drivers/media/platform/qcom/venus/sq2-venus-system-pm.h
--- a/drivers/media/platform/qcom/venus/sq2-venus-system-pm.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2-venus-system-pm.h	2026-11-20 21:12:16.459243284 +0100
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Caller serializes transitions. A failed hardware transition is terminal;
+ * busy/live sessions do not consume a transition. No retry budget or timer. */
+#ifndef SQ2_VENUS_SYSTEM_PM_H
+#define SQ2_VENUS_SYSTEM_PM_H
+/* Positive callback result: no firmware/DMA transition occurred and IRQ
+ * delivery has been restored. Never use for a partial or failed stop. */
+#define SQ2_PM_STOP_UNCHANGED_BUSY 1
+enum sq2_system_pm_phase {
+ SQ2_PM_RUNNING, SQ2_PM_OFF, SQ2_PM_BROKEN, SQ2_PM_STOPPING, SQ2_PM_STARTING
+};
+struct sq2_system_pm {
+ enum sq2_system_pm_phase phase;
+ int error;
+ unsigned long stops, starts;
+};
+struct sq2_system_pm_ops {
+ int (*idle)(void *);
+ int (*stop)(void *);
+ int (*start)(void *);
+};
+static inline int sq2_system_pm_suspend(struct sq2_system_pm *s,
+ const struct sq2_system_pm_ops *ops, void *ctx)
+{
+ int ret;
+ if (s->phase == SQ2_PM_BROKEN) return s->error;
+ if (s->phase == SQ2_PM_OFF) return 0;
+ if (s->phase != SQ2_PM_RUNNING) return -EBUSY;
+ ret = ops->idle(ctx);
+ if (ret) return ret;
+ s->phase = SQ2_PM_STOPPING;
+ ret = ops->stop(ctx);
+ if (ret == SQ2_PM_STOP_UNCHANGED_BUSY) {
+  s->phase = SQ2_PM_RUNNING; return -EBUSY;
+ }
+ if (ret) {
+  s->error = ret; s->phase = SQ2_PM_BROKEN; return ret;
+ }
+ s->stops++; s->phase = SQ2_PM_OFF;
+ return 0;
+}
+static inline int sq2_system_pm_resume(struct sq2_system_pm *s,
+ const struct sq2_system_pm_ops *ops, void *ctx)
+{
+ int ret;
+ if (s->phase == SQ2_PM_BROKEN) return s->error;
+ if (s->phase == SQ2_PM_RUNNING) return 0;
+ if (s->phase != SQ2_PM_OFF) return -EBUSY;
+ s->phase = SQ2_PM_STARTING;
+ ret = ops->start(ctx);
+ if (ret) {
+  s->error = ret; s->phase = SQ2_PM_BROKEN; return ret;
+ }
+ s->starts++; s->phase = SQ2_PM_RUNNING;
+ return 0;
+}
+#endif
diff -ruN a/drivers/media/platform/qcom/venus/sq2_video_fw_layout.h b/drivers/media/platform/qcom/venus/sq2_video_fw_layout.h
--- a/drivers/media/platform/qcom/venus/sq2_video_fw_layout.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/qcom/venus/sq2_video_fw_layout.h	2026-11-20 21:12:16.467752052 +0100
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* The 6.3 MDT loader assumes program headers immediately follow ELF32_Ehdr.
+ * Validate that assumption and every source/destination before calling it.
+ * This deliberately accepts only complete, relocatable ARM ELF32 images.
+ */
+#ifndef SQ2_VIDEO_FW_LAYOUT_H
+#define SQ2_VIDEO_FW_LAYOUT_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+typedef uint32_t u32;
+typedef uint64_t u64;
+#endif
+
+#define SQ2_FW_LIMIT (6U * 1024 * 1024)
+#define SQ2_FW_MAX_SEGMENTS 32
+struct sq2_fw_segment { u32 source, address, filesz, memsz; };
+struct sq2_fw_layout {
+ u32 base, span, count;
+ struct sq2_fw_segment segments[SQ2_FW_MAX_SEGMENTS];
+};
+
+static u32 sq2_fw_u32(const unsigned char *p)
+{
+ return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+static int sq2_fw_layout(const unsigned char *b, size_t size,
+                        struct sq2_fw_layout *out)
+{
+ u32 i, j, count, base = 0xffffffffU;
+ u64 end = 0;
+
+ out->count = 0;
+ out->base = out->span = 0;
+ if (size < 52 || size > SQ2_FW_LIMIT || b[0] != 0x7f ||
+     b[1] != 'E' || b[2] != 'L' || b[3] != 'F' ||
+     b[4] != 1 || b[5] != 1 || b[6] != 1 ||
+     b[18] != 40 || b[19] || sq2_fw_u32(b + 20) != 1 ||
+     sq2_fw_u32(b + 28) != 52 || b[40] != 52 || b[41] ||
+     b[42] != 32 || b[43])
+  return -1;
+ count = (u32)b[44] | (u32)b[45] << 8;
+ if (!count || count > SQ2_FW_MAX_SEGMENTS || 52U + count * 32U > size)
+  return -1;
+ for (i = 0; i < count; i++) {
+  const unsigned char *p = b + 52 + i * 32;
+  u32 source = sq2_fw_u32(p + 4), addr = sq2_fw_u32(p + 12);
+  u32 fs = sq2_fw_u32(p + 16), ms = sq2_fw_u32(p + 20);
+  u32 flags = sq2_fw_u32(p + 24);
+  struct sq2_fw_segment *s;
+
+  if (sq2_fw_u32(p) != 1 || ((flags >> 24) & 7) == 2 || !ms)
+   continue;
+  if (!(flags & (1U << 27)) || fs > ms ||
+      (u64)source + fs > size || (u64)addr + ms > 0xffffffffULL)
+   return -1;
+  for (j = 0; j < out->count; j++) {
+   s = &out->segments[j];
+   if ((u64)addr < (u64)s->address + s->memsz &&
+       (u64)s->address < (u64)addr + ms)
+    return -1;
+  }
+  s = &out->segments[out->count++];
+  s->source = source; s->address = addr; s->filesz = fs; s->memsz = ms;
+  if (addr < base)
+   base = addr;
+  if ((u64)addr + ms > end)
+   end = (u64)addr + ms;
+ }
+ end = (end + 4095) & ~4095ULL;
+ if (!out->count || (base & 4095) || end <= base || end - base > SQ2_FW_LIMIT)
+  return -1;
+ out->base = base;
+ out->span = end - base;
+ return 0;
+}
+#endif
