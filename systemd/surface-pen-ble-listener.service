[Unit]
Description=Surface Slim Pen BLE Auto-Connect Daemon
After=bluetooth.service surface-bluetooth-mac.service
Wants=surface-bluetooth-mac.service
Requires=bluetooth.service

[Service]
Type=simple
# Optional override; if unset, auto-discovers paired Surface Pen on BlueZ:
# Environment=SURFACE_PEN_MAC=AA:BB:CC:DD:EE:FF
ExecStart=/usr/local/bin/surface-pen-ble-listener
Restart=always
RestartSec=3

[Install]
WantedBy=bluetooth.target graphical.target
