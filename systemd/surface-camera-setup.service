[Unit]
Description=Surface Pro X Camera, Privacy LEDs & Windows Hello IR Face ID Setup
DefaultDependencies=no
After=systemd-udevd.service systemd-modules-load.service local-fs.target
Before=display-manager.service gdm.service multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/surface-camera-load
RemainAfterExit=yes
TimeoutSec=30

[Install]
WantedBy=multi-user.target
