[Unit]
Description=Surface Pro X Camera, Privacy LEDs & Windows Hello IR Face ID Setup
After=basic.target local-fs.target systemd-udev-trigger.service rmtfs.service
Before=gdm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/surface-camera-load
RemainAfterExit=yes
TimeoutSec=25

[Install]
WantedBy=graphical.target
