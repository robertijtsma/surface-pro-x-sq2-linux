[Unit]
Description=Surface Pro X SQ2 Clean Pre-Shutdown Teardown (Venus VPU & IPA v4.1)
DefaultDependencies=no
After=multi-user.target
Before=shutdown.target reboot.target poweroff.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/local/bin/surface-pre-shutdown.sh
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
